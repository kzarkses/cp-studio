PATP[200] = 214; PDEF[200] = 4;
PATP[201] = 215; PDEF[201] = 0;
PATP[202] = 216; PDEF[202] = 50;
PATP[203] = 217; PDEF[203] = 0;
PATP[204] = 218; PDEF[204] = 1;
PATP[205] = 228; PDEF[205] = 0;
PATP[206] = 229; PDEF[206] = 1;
function seq_mask(sc) (
  sc < 0.5 ? 4095 :
  sc < 1.5 ? 2741 :
  sc < 2.5 ? 1453 :
  sc < 3.5 ? 1709 :
  sc < 4.5 ? 1451 :
  sc < 5.5 ? 2773 :
  sc < 6.5 ? 1717 :
  sc < 7.5 ? 1387 :
  sc < 8.5 ? 2477 :
  sc < 9.5 ? 2733 :
  sc < 10.5 ? 661 :
  sc < 11.5 ? 1193 :
  sc < 12.5 ? 1257 :
  sc < 13.5 ? 1365 :
  sc < 14.5 ? 129 :
  1;
);
snd = -1; snd_ch = 0; off_at = -1;
abs_s = 0; fb = 0; last_src = 0; last_b1 = 0; k_last = -1; last_stepT = 0;
rev = 0; booted = 0; last_roll = 0; in_tr = 0; last_sc = -1; NDEG = 12;
note_last = -1; evn = 0; inn = 0; stepT = 0.25; stepB = 0.25; swd = 0; dir = 0;
spb_s = 24000;
i = 0;
loop(NL, PCYC[i] = 0; PPER[i] = -1; PSPD[i] = -1; POS[i] = 0; i += 1;);
i = 0;
loop(12, DEG[i] = i; i += 1;);

// L'ETAT DES PATTERNS ET DE L'ARPEGE NE NAIT QU'UNE FOIS. @init peut repasser
// (une autre frequence d'echantillonnage) et ne doit pas effacer seize
// patterns ; un projet rouvert les pose par @serialize, qui passe APRES @init.
pt_boot < 0.5 ? (
  pt_cur = 0; pt_mask = 1; pt_pend = -1; pt_at = -1; pt_g = 0;
  pt_rq = -1; pt_rqo = 0; pt_lreq = 0; pt_ser = 0; pt_dirty = 1; pt_lch = -1;
  ar_n = 0; ar_phys = 0; ar_i = 0; ar_srt = 0; ar_lat = 0; ar_qn = 0; ar_qi = 0; ar_lnm = -1;
  i = 0;
  loop(128, ARK[i] = 0; i += 1;);
  pt_boot = 1;
);

function m_mod(x, n) ( x - floor(x / n) * n );

// LES DEGRES DE LA GAMME COURANTE. Le masque vient de `seq_mask`, generee
// depuis la table du Sound Gen.
function seq_degs(sc) local(mask k) (
  mask = seq_mask(sc);
  NDEG = 0; k = 0;
  loop(12,
    ((mask >> k) & 1) ? ( DEG[NDEG] = k; NDEG += 1; );
    k += 1;
  );
  NDEG < 1 ? ( DEG[0] = 0; NDEG = 1; );
);

// Les demi-tons du degre `d` (entier, negatif permis). Miroir de
// `Sequencer.degSemi`.
function deg_semi(d) local(oc i) (
  d = floor(d + 0.5);
  oc = floor(d / NDEG);
  i = d - oc * NDEG;
  oc * 12 + DEG[i];
);

// La valeur du slider (ligne L, decalage j).
function sp(L, j) ( slider(GB + L * LS + j + 1) );

// LA PERIODE d'une ligne de n pas : n en avant, en arriere et au hasard ;
// 2n - 2 en aller-retour (les deux bouts ne se repetent pas).
function lane_per(n) (
  (dir > 1.5 && dir < 2.5) ? ( n > 1 ? 2 * n - 2 : 1 ) : n;
);

// LE HASARD DU SENS « RANDOM » EST UNE FONCTION DE LA POSITION, PAS UN TIRAGE.
// Un saut de tete, une boucle de l'arrangeur, un rendu hors ligne rejouent donc
// le meme ordre : rien n'est a rattraper. Des entiers sous 2^31, rien de plus.
function seq_hash(k, L) local(a h) (
  a = m_mod(k, 32768);
  h = m_mod(a * 1103 + L * 7919 + 12345, 32749);
  h = m_mod(h * h + 1013, 32749);
  floor(h / 7);
);

function lane_pos(L, k, n) local(i) (
  dir < 0.5 ? m_mod(k, n)
  : dir < 1.5 ? n - 1 - m_mod(k, n)
  : dir < 2.5 ? ( n < 2 ? 0 : ( i = m_mod(k, 2 * n - 2); i < n ? i : 2 * n - 2 - i ) )
  : m_mod(seq_hash(k, L), n);
);

// L'index de pas ABSOLU de la ligne L au temps t (en noires). La place d'une
// ligne se DEDUIT de la position : c'est ce qui rend la polyrythmie juste
// apres n'importe quel saut.
function lane_k(L, t) ( floor(t * SPDF[L] / stepB + 0.000001) );

// LE TIRAGE D'UN PAS. `a` = la quantite : 1 tire dans toute la plage, 0 ne
// change rien, entre les deux le pas va plus ou moins loin vers le tirage. Un
// interrupteur, lui, est retire avec la probabilite `a`, et s'allume avec la
// densite `hi`.
function roll_step(L, j, a) local(p lo hi r v t) (
  p = GB + L * LS + j + 1;
  lo = slider(GB + L * LS + O_LO + 1);
  hi = slider(GB + L * LS + O_HI + 1);
  LBOOL[L] > 0.5 ? (
    rand(1) < a ? ( slider(p) = (rand(1) < hi) ? 1 : 0; );
  ) : (
    lo > hi ? ( t = lo; lo = hi; hi = t; );
    LINT[L] > 0.5 ? (
      r = floor(lo + rand(1) * (hi - lo + 1));
      r > hi ? ( r = hi; );
    ) : (
      r = lo + rand(1) * (hi - lo);
    );
    v = slider(p);
    v = v + (r - v) * a;
    LINT[L] > 0.5 ? ( v = floor(v + 0.5); );
    v < LMIN[L] ? ( v = LMIN[L]; );
    v > LMAX[L] ? ( v = LMAX[L]; );
    slider(p) = v;
  );
);

// Le de d'une ligne : ses pas QUI JOUENT. Ceux d'apres la longueur sont gardes
// pour le jour ou on rallonge, comme dans le sequenceur de CP_Mod.
function dice_lane(L) local(a j) (
  a = slider(GB + L * LS + O_DICE + 1) * 0.01;
  j = 0;
  loop(LENA[L], roll_step(L, j, a); j += 1;);
);

// LA MUTATION (Turing Machine) : a chaque tour de la ligne, chacun de ses pas a
// `mut` % de chances d'etre retire dans sa plage. 0 % = boucle figee.
function mutate_lane(L) local(m j ch) (
  m = slider(GB + L * LS + O_MUT + 1) * 0.01;
  m > 0.0001 ? (
    j = 0; ch = 0;
    loop(LENA[L],
      rand(1) < m ? ( roll_step(L, j, 1); ch = 1; );
      j += 1;
    );
    ch ? ( rev += 1; sliderchange(-1); );
  );
);

// Pose le tour et le pas d'une ligne SANS muter : apres un saut, un depart, un
// changement de longueur ou de vitesse.
function lane_sync(L, t) local(k n) (
  n = LENA[L]; k = lane_k(L, t);
  PCYC[L] = floor(k / lane_per(n));
  POS[L] = lane_pos(L, k, n);
);

// Avance une ligne au temps t. ⚠ LE TOUR NE RECULE JAMAIS : une note retardee
// par le swing peut etre datee un peu avant la fin du bloc precedent, et un
// tour qui reculerait puis repasserait muterait deux fois.
function lane_tick(L, t) local(k n c) (
  n = LENA[L]; k = lane_k(L, t);
  c = floor(k / lane_per(n));
  c > PCYC[L] ? ( mutate_lane(L); PCYC[L] = c; );
  POS[L] = lane_pos(L, k, n);
);

function ev_push(o, a, b, c) local(e) (
  evn < 64 ? (
    e = EVQ + evn * 4;
    e[0] = o; e[1] = a; e[2] = b; e[3] = c;
    evn += 1;
  );
);

// ⚠ LA NOTE-OFF EST GARANTIE. Une note pendue est le pire defaut d'un
// sequenceur : toute coupure (arret, saut, changement de mode, extinction)
// passe par ici.
function note_kill(o) (
  snd >= 0 ? (
    ev_push(o, 0x80 + snd_ch, snd, 0);
    snd = -1; off_at = -1;
  );
);

// La date d'un pas de TRIG, swing compris : les pas IMPAIRS sont retardes, de
// une demi-case au plus (le 75 % d'une MPC).
function tsw(k) ( k * stepT + (m_mod(k, 2) > 0.5 ? swd : 0) );

// LA VALEUR D'UNE LIGNE LIBRE A L'INSTANT t (en noires), pour la publication
// rapide. Une fonction de la DATE, pas de l'etat du bloc : la ligne change a
// son propre pas, quelle que soit sa vitesse. Le swing la deplace comme il
// deplace les notes -- l'instant est ramene a sa date NON swinguee, comme
// `fire` lit les lignes a `k * stepT` --, et un pas d'une ligne a la vitesse de
// TRIG tombe donc avec sa note. Un tour qui commence pendant le bloc lit les
// pas MUTES (`lane_tick` les a deja retires) ; le tour en cours lit la photo
// prise avant (`SNAP`), sinon un pas finirait avec la valeur du suivant.
function line_at(L, s, t) local(m r u k n c) (
  swd > 0 ? (
    m = floor(t / (2 * stepT));
    r = t - m * 2 * stepT;
    u = r < stepT + swd ? m * 2 * stepT + r * stepT / (stepT + swd)
                        : m * 2 * stepT + stepT + (r - stepT - swd) * stepT / (stepT - swd);
  ) : (
    u = t;
  );
  n = LENA[L];
  k = lane_k(L, u);
  c = floor(k / lane_per(n));
  k = lane_pos(L, k, n);
  c > PC0[s] ? sp(L, k) : SNAP[s * 16 + k];
);

function seq_reset(t) local(L) (
  k_last = ceil(t / stepT - 0.000001) - 1;
  L = 0;
  loop(NL,
    lane_sync(L, t);
    PPER[L] = lane_per(LENA[L]); PSPD[L] = SPDF[L];
    L += 1;
  );
  last_stepT = stepT;
  // Un depart, un saut : l'arpege repart de sa premiere note.
  ar_i = 0;
);

// ---------------------------------------------------------------------------
// LES PATTERNS. Les sliders SONT le pattern courant ; la memoire tient les
// seize, et le courant y est range quand on le quitte (ou qu'on le sauve).
// ---------------------------------------------------------------------------
function pt_save(n) local(i b) (
  b = PATM + n * 256; i = 0;
  loop(NPV, b[i] = slider(PATP[i]); i += 1;);
  pt_mask |= (1 << n);
  pt_dirty = 1;
);

// Poser le pattern n dans les sliders. Le panneau le relit comme un tirage.
function pt_load(n) local(i b) (
  b = PATM + n * 256; i = 0;
  loop(NPV, slider(PATP[i]) = b[i]; i += 1;);
  rev += 1;
  sliderchange(-1);
);

function pt_defs(n) local(i b) (
  b = PATM + n * 256; i = 0;
  loop(NPV, b[i] = PDEF[i]; i += 1;);
  pt_mask |= (1 << n);
  pt_dirty = 1;
);

// CHANGER DE PATTERN. Ce qu'on quitte est range ; un pattern jamais visite
// nait COPIE de celui qu'on quitte -- une variation part de ce qui joue --, un
// pattern defini est pose.
function pt_apply(n) (
  n != pt_cur ? (
    pt_save(pt_cur);
    ((pt_mask >> n) & 1) ? pt_load(n) : pt_save(n);
    pt_cur = n;
  );
  pt_pend = -1; pt_at = -1;
  pt_dirty = 1;
);

function pt_copy(a, b) local(i) (
  a == pt_cur ? pt_save(a);
  (a != b && ((pt_mask >> a) & 1)) ? (
    i = 0;
    loop(NPV, PATM[b * 256 + i] = PATM[a * 256 + i]; i += 1;);
    pt_mask |= (1 << b);
    b == pt_cur ? pt_load(b);
    pt_dirty = 1;
  );
);

// Effacer = remettre aux defauts (un pattern efface reste DEFINI : il est
// vide de musique, pas absent).
function pt_clear(n) (
  pt_defs(n);
  n == pt_cur ? pt_load(n);
);

// L'Init : un seul pattern, le premier, et les sliders n'y sont pour rien
// (Lua les remet aux defauts lui-meme).
function pt_resetall() local(k) (
  k = 0;
  loop(16, pt_defs(k); k += 1;);
  pt_cur = 0; pt_mask = 1; pt_pend = -1; pt_at = -1;
  pt_dirty = 1;
);

// LA BOITE D'ARRIVEE : seize patterns deposes par Lua (un preset, un Remove,
// une mise a niveau), adoptes seulement si le jeton est le notre.
function pt_adopt() local(ib nv k i c m) (
  pt_ch = floor(seq_pch + 0.5);
  (pt_ch >= 1 && pt_ch <= 255 && seq_ptok >= 1) ? (
    ib = PATG + pt_ch * PGS + PIN;
    gmem[ib] == seq_ptok ? (
      nv = floor(gmem[ib + 4] + 0.5);
      nv > NPV ? ( nv = NPV; );
      nv < 0 ? ( nv = 0; );
      m = (floor(gmem[ib + 3] + 0.5) & 65535);
      c = floor(gmem[ib + 2] + 0.5);
      c < 0 ? ( c = 0; );
      c > 15 ? ( c = 15; );
      k = 0;
      loop(16,
        i = 0;
        loop(NPV,
          PATM[k * 256 + i] = (i < nv) ? gmem[ib + PHD + k * 256 + i] : PDEF[i];
          i += 1;
        );
        k += 1;
      );
      pt_mask = (m | (1 << c));
      pt_cur = c; pt_pend = -1; pt_at = -1;
      pt_load(c);
      pt_dirty = 1;
    );
  );
);

// LE MIROIR : les patterns DEFINIS, publies pour Lua. Le courant vient des
// sliders (sa case en memoire peut dater de la derniere fois qu'on l'a quitte).
// Le numero de version s'ecrit EN DERNIER : Lua relit si il a bouge pendant sa
// lecture.
function pt_publish() local(gb k i b) (
  gb = PATG + pt_ch * PGS;
  gmem[gb] = seq_ptok; gmem[gb + 2] = pt_cur; gmem[gb + 3] = pt_mask; gmem[gb + 4] = NPV;
  gmem[gb + 5] = pt_pend;
  k = 0;
  loop(16,
    ((pt_mask >> k) & 1) ? (
      b = gb + PHD + k * 256; i = 0;
      k == pt_cur ? (
        loop(NPV, gmem[b + i] = slider(PATP[i]); i += 1;);
      ) : (
        loop(NPV, gmem[b + i] = PATM[k * 256 + i]; i += 1;);
      );
    );
    k += 1;
  );
  gmem[gb + 1] += 1;
);

// La date ou un changement demande prend effet, en noires (-1 = maintenant).
// Une mesure est de quatre noires (la convention de CP_Mod) ; la fin du
// pattern est celle du tour de TRIG. Une demande posee PILE sur la grille
// (a un millieme de case pres) prend cette case.
function pt_when(t) local(q g) (
  q = floor(seq_pq + 0.5);
  g = (q == 1) ? 1 : (q == 2) ? 4 : (q == 3) ? lane_per(LENA[0]) * stepT : 0;
  pt_g = g;
  g > 0 ? ceil(t / g - 0.001) * g : -1;
);

// CE QUI NE CHANGE QU'AU BLOC, lu dans les sliders. Une fonction parce qu'un
// changement de pattern (en tete de bloc) le relit aussitot : la division, les
// longueurs, les vitesses, le swing et la gamme sont dans le pattern.
function blk_params() local(L n si) (
  dir = floor(seq_dir + 0.5);
  ri = floor(seq_rate + 0.5);
  ri < 0 ? ( ri = 0; );
  ri > 8 ? ( ri = 8; );
  stepB = RATEB[ri];
  L = 0;
  loop(NL,
    n = floor(slider(GB + L * LS + O_LEN + 1) + 0.5);
    n < 1 ? ( n = 1; );
    n > NS ? ( n = NS; );
    LENA[L] = n;
    si = floor(slider(GB + L * LS + O_SPD + 1) + 0.5);
    si < 0 ? ( si = 0; );
    si > 8 ? ( si = 8; );
    SPDF[L] = SPDT[si];
    L += 1;
  );
  stepT = stepB / SPDF[0];
  swd = seq_swing * 0.005 * stepT;
  sc = floor(seq_scale + 0.5);
  sc != last_sc ? ( seq_degs(sc); last_sc = sc; );
  tonic = 12 * (floor(seq_oct + 0.5) + 1) + floor(seq_root + 0.5);
  transp = floor(seq_transp + 0.5);
);

// ---------------------------------------------------------------------------
// L'ARPEGE : les notes tenues, et la hauteur d'un pas
// ---------------------------------------------------------------------------
function ar_sort() local(i j t) (
  i = 0;
  loop(ar_n, ARS[i] = ARH[i]; i += 1;);
  i = 1;
  while (i < ar_n) (
    t = ARS[i]; j = i - 1;
    while (j >= 0 && ARS[j] > t) ( ARS[j + 1] = ARS[j]; j -= 1; );
    ARS[j + 1] = t;
    i += 1;
  );
  ar_srt = 1;
);

// Une note recue. ⚠ LE LOQUET COMPTE LES DOIGTS (`ARK`), pas les messages :
// une touche relancee sans note-off ne compte pas deux fois. Loquet mis, la
// premiere touche baissee quand toutes etaient levees REMPLACE l'accord.
function ar_event(s, nt, vl) local(i j f) (
  nt = (nt | 0) & 127;
  (s == 0x90 && vl > 0) ? (
    (ar_lat && ar_phys == 0) ? ( ar_n = 0; );
    ar_n == 0 ? ( ar_i = 0; );
    ARK[nt] < 0.5 ? ( ARK[nt] = 1; ar_phys += 1; );
    f = 0; i = 0;
    loop(ar_n, ARH[i] == nt ? ( f = 1; ); i += 1;);
    (f == 0 && ar_n < 32) ? ( ARH[ar_n] = nt; ar_n += 1; );
  ) : (
    ARK[nt] > 0.5 ? ( ARK[nt] = 0; ar_phys -= 1; );
    ar_lat == 0 ? (
      i = 0; j = 0;
      loop(ar_n, ARH[i] != nt ? ( ARH[j] = ARH[i]; j += 1; ); i += 1;);
      ar_n = j;
    );
  );
  ar_srt = 0;
);

// Le loquet qu'on releve garde les touches encore baissees, rien d'autre.
function ar_unlatch() local(i k) (
  i = 0; k = 0;
  loop(ar_n, ARK[ARH[i]] > 0.5 ? ( ARH[k] = ARH[i]; k += 1; ); i += 1;);
  ar_n = k; ar_srt = 0;
);

// Les notes recues jusqu'a l'offset o, dans l'ordre : un accord pose sur la
// meme date qu'un pas compte pour ce pas, un accord relache apres lui non.
function ar_upto(o) local(e) (
  while (ar_qi < ar_qn && ARQ[ar_qi * 4] <= o) (
    e = ARQ + ar_qi * 4;
    ar_event(e[1], e[2], e[3]);
    ar_qi += 1;
  );
);

// LA HAUTEUR D'UN PAS ARPEGE. L'ordre parcourt l'accord sur `seq_arpo`
// octaves ; `off` (la ligne PITCH) decale dans l'accord, au-dela d'un tour on
// change d'octave. « As Played » parcourt l'ordre de jeu, les autres l'accord
// trie.
function ar_note(off) local(m oc nn per i t c k) (
  ar_srt < 0.5 ? ar_sort();
  m = floor(seq_arpm + 0.5);
  oc = floor(seq_arpo + 0.5);
  oc < 1 ? ( oc = 1; );
  oc > 4 ? ( oc = 4; );
  nn = ar_n * oc;
  per = (nn > 1) ? 2 * nn - 2 : 1;
  i = m_mod(ar_i, per);
  t = (m == 1) ? nn - 1 - m_mod(ar_i, nn)
    : (m == 2) ? ( i < nn ? i : per - i )
    : (m == 3) ? nn - 1 - ( i < nn ? i : per - i )
    : (m == 5) ? floor(rand(nn))
    : m_mod(ar_i, nn);
  t += off;
  c = floor(t / ar_n);
  k = t - c * ar_n;
  ((m == 4) ? ARH[k] : ARS[k]) + 12 * c;
);

// UN PAS DE TRIG : la note, si le pas joue. Les autres lignes sont lues a la
// date NON swinguee du pas — le swing deplace la note, pas la melodie.
//
// LE GLISSE : la note tient jusqu'au pas suivant (`off_at` = -1) et la
// suivante part AVANT sa note-off, le legato des monosynthes. Meme hauteur :
// rien n'est relance, la note continue.
function fire(k, o) local(tT on pr nt vl sl gt dist L) (
  tT = k * stepT;
  L = 0; loop(NL, lane_tick(L, tT); L += 1;);
  (snd >= 0 && off_at >= 0 && off_at <= abs_s + o) ? note_kill(max(0, off_at - abs_s));
  // L'accord tenu A LA DATE du pas : les notes recues jusque-la, pas au-dela.
  ar_on ? ar_upto(o);
  on = sp(0, POS[0]) > 0.5;
  on ? ( pr = sp(5, POS[5]); on = rand(100) < pr; );
  // Rien de tenu : un silence, comme un pas eteint.
  (on && ar_on && ar_n < 1) ? ( on = 0; );
  on ? (
    ar_on ? (
      // ARP : la hauteur vient de l'accord ; PITCH y decale, OCT et TRANSP
      // gardent leur role. La gamme et la tonique ne servent pas.
      nt = ar_note(floor(sp(1, POS[1]) + 0.5)) + 12 * floor(sp(2, POS[2]) + 0.5) + transp;
      ar_i += 1;
    ) : (
      nt = tonic + deg_semi(sp(1, POS[1])) + 12 * floor(sp(2, POS[2]) + 0.5) + transp + in_tr;
    );
    nt = floor(nt + 0.5);
    nt < 0 ? ( nt = 0; );
    nt > 127 ? ( nt = 127; );
    vl = floor(sp(3, POS[3]) + 0.5);
    vl < 1 ? ( vl = 1; );
    vl > 127 ? ( vl = 127; );
    sl = sp(6, POS[6]) > 0.5;
    dist = (tsw(k + 1) - tsw(k)) * spb_s;
    gt = floor(sp(4, POS[4]) * 0.01 * dist) - 1;
    gt < 16 ? ( gt = 16; );
    (snd >= 0 && off_at < 0) ? (
      nt != snd ? (
        ev_push(o, 0x90 + chan, nt, vl);
        ev_push(o, 0x80 + snd_ch, snd, 0);
        snd = nt; snd_ch = chan;
      );
    ) : (
      snd >= 0 ? note_kill(o);
      ev_push(o, 0x90 + chan, nt, vl);
      snd = nt; snd_ch = chan;
    );
    off_at = sl ? -1 : abs_s + o + gt;
    note_last = nt;
  ) : (
    (snd >= 0 && off_at < 0) ? note_kill(o);
  );
);

@block
// ---- ce qui ne change qu'au bloc --------------------------------------------
tb = tempo > 1 ? tempo : 120;
spb_s = srate * 60 / tb;
blk_b = samplesblock / spb_s;
chan = floor(seq_chan + 0.5) - 1;
chan < 0 ? ( chan = 0; );
chan > 15 ? ( chan = 15; );
blk_params();
evn = 0;

// ---- le MIDI recu ---------------------------------------------------------------
// Les seize notes de pattern (et les changements de programme 0..15) ne
// passent jamais : elles demandent un pattern. Le reste selon le sens des notes
// recues : Thru les laisse passer, Transpose les lit comme une transposition,
// Arp les tient pour l'arpege (et ne les rend pas non plus).
nm = floor(seq_notein + 0.5);
ar_on = nm == 2;
nm != ar_lnm ? (
  // Un autre sens : l'accord tenu ne vaut plus rien.
  ar_n = 0; ar_phys = 0; ar_srt = 0;
  i = 0;
  loop(128, ARK[i] = 0; i += 1;);
  ar_lnm = nm;
);
seq_arpl > 0.5 ? ( ar_lat = 1; ) : ( ar_lat ? ar_unlatch(); ar_lat = 0; );
pbase = (seq_pnote >= 0.5) ? (floor(seq_pnote + 0.5) - 1) * 12 : -1;
inn = 0; ar_qn = 0; ar_qi = 0;
while (midirecv(mo, m1, m2, m3)) (
  st = m1 & 0xF0;
  isn = (st == 0x90 || st == 0x80);
  ispat = 0;
  pbase >= 0 ? (
    (isn && m2 >= pbase && m2 < pbase + 16) ? (
      (st == 0x90 && m3 > 0) ? ( pt_rq = m2 - pbase; pt_rqo = mo; );
      ispat = 1;
    );
    (st == 0xC0 && m2 < 16) ? ( pt_rq = m2; pt_rqo = mo; ispat = 1; );
  );
  ispat ? (
    0;
  ) : (nm == 1 && isn) ? (
    (st == 0x90 && m3 > 0) ? ( in_tr = m2 - 60; );
  ) : (nm == 2 && isn) ? (
    ar_qn < 256 ? (
      e = ARQ + ar_qn * 4;
      e[0] = mo; e[1] = st; e[2] = m2; e[3] = m3;
      ar_qn += 1;
    );
  ) : (
    inn < 256 ? (
      e = INQ + inn * 4;
      e[0] = mo; e[1] = m1; e[2] = m2; e[3] = m3;
      inn += 1;
    );
  );
);
nm != 1 ? ( in_tr = 0; );

// ---- la demande de tirage ----------------------------------------------------
// ⚠ ADOPTEE AU PREMIER BLOC, PAS EXECUTEE. Le projet rouvert rend la derniere
// demande au slider : la prendre pour neuve retirerait les lignes a chaque
// ouverture.
booted < 0.5 ? ( last_roll = seq_roll; booted = 1; );
seq_roll != last_roll ? (
  last_roll = seq_roll;
  msk = m_mod(seq_roll, 512);
  L = 0;
  loop(NL,
    ((msk >> L) & 1) ? dice_lane(L);
    L += 1;
  );
  rev += 1;
  sliderchange(-1);
);

// ---- l'horloge : comme Session ----------------------------------------------
// Auto : le transport quand REAPER joue, la notre (Run) quand il est arrete.
// Transport : seulement quand REAPER joue. Free : la notre, toujours.
playing = (play_state == 1 || play_state == 5);
clk = floor(seq_clock + 0.5);
src = 0;
seq_on > 0.5 ? (
  (clk != 2 && playing) ? ( src = 1; )
  : (clk != 1 && seq_run > 0.5) ? ( src = 2; );
);

// ---- le pattern : la demande de Lua, puis ce qui prend effet ------------------
// ⚠ ADOPTEE AU PREMIER BLOC QUI SUIT UN @serialize LU (projet rouvert, piste
// dupliquee, annulation) : la derniere demande est dans le slider, la rejouer
// relirait une boite perimee. Une instance NEUVE (posee par Lua) execute la
// sienne : c'est ainsi qu'une mise a niveau lui rend ses patterns.
pt_ser > 0.5 ? ( pt_lreq = seq_preq; pt_ser = 0; );
seq_preq != pt_lreq ? (
  pt_lreq = seq_preq;
  pq_v = m_mod(floor(seq_preq + 0.5), 4096);
  pq_op = floor(pq_v / 256);
  pq_a = pq_v - pq_op * 256;
  pq_op == 1 ? ( pt_rq = (pq_a & 15); pt_rqo = 0; )
  : pq_op == 2 ? pt_copy(floor(pq_a / 16), (pq_a & 15))
  : pq_op == 3 ? pt_clear(pq_a & 15)
  : pq_op == 4 ? pt_adopt()
  : pq_op == 5 ? ( pt_dirty = 1; )
  : pq_op == 6 ? pt_resetall();
);
// La date de la tete pour la quantification : la position du transport, ou
// celle de la boucle libre (celle ou il s'est arrete s'il vient de s'arreter).
pt_t0 = (src == 1) ? beat_position : (src == 2 && last_src == 1) ? last_b1 : fb;
pt_rq >= 0 ? (
  pt_at = (src == 0) ? -1 : pt_when(pt_t0 + pt_rqo / spb_s);
  pt_pend = pt_rq; pt_rq = -1;
);
// ⚠ IL PREND EFFET EN TETE DU BLOC qui contient sa date : un pas pose sur la
// meme date le joue deja, et c'est le cas de toute note de pattern posee sur la
// grille d'un clip. Un pas qui tomberait AVANT dans ce meme bloc le prend aussi
// (moins d'un bloc d'avance) -- il faudrait un pas plus court qu'un bloc.
pt_pend >= 0 ? (
  (src != 0 && pt_at >= 0 && pt_g > 0 && pt_at - pt_t0 > pt_g + 0.000001) ? (
    // La tete est revenue en arriere (une boucle, un saut) : la prochaine case.
    pt_at = ceil(pt_t0 / pt_g - 0.001) * pt_g;
  );
  (src == 0 || pt_at < 0 || pt_at < pt_t0 + blk_b) ? (
    pt_apply(pt_pend);
    blk_params();
  );
);
b0 = 0;
src == 1 ? ( b0 = beat_position; );
src == 2 ? ( b0 = fb; );
src != last_src ? (
  (last_src == 1 && src == 2) ? (
    // Le transport s'arrete et la boucle libre continue SANS TROU, la ou il
    // etait.
    b0 = last_b1; fb = b0;
  ) : (
    note_kill(0);
    // Un depart a la main part du pas 1.
    src == 2 ? ( fb = 0; b0 = 0; );
    src != 0 ? seq_reset(b0);
  );
) : (
  // UN SAUT DE TETE, UNE BOUCLE DE L'ARRANGEUR : la position ne suit plus.
  (src == 1 && abs(b0 - last_b1) > blk_b * 0.5 + 0.0001) ? (
    note_kill(0);
    seq_reset(b0);
  );
);

src != 0 ? (
  // La grille a change (division, vitesse de TRIG) : on se recale dessus.
  stepT != last_stepT ? ( k_last = ceil(b0 / stepT - 0.000001) - 1; last_stepT = stepT; );
  // Une longueur, une vitesse ou un sens change : le tour se repose sans muter.
  L = 0;
  loop(NL,
    (lane_per(LENA[L]) != PPER[L] || SPDF[L] != PSPD[L]) ? (
      lane_sync(L, b0);
      PPER[L] = lane_per(LENA[L]); PSPD[L] = SPDF[L];
    );
    L += 1;
  );
  // LA PHOTO DES DEUX LIGNES LIBRES, avant que le bloc ne les mute (voir
  // `line_at`) : apres un saut ou un depart, c'est le tour qu'on vient de poser.
  sj = 0;
  loop(16, SNAP[sj] = sp(7, sj); SNAP[16 + sj] = sp(8, sj); sj += 1;);
  PC0[0] = PCYC[7]; PC0[1] = PCYC[8];
  b1 = b0 + blk_b;
  guard = 0;
  // ⚠ UN PAS SE COMPTE PAR SON NUMERO, PAS PAR LA POSITION DU BLOC. Deux blocs
  // ne se raccordent pas au bit pres (le tempo de REAPER s'integre, le notre
  // se multiplie) : comparer des dates doublerait ou perdrait le pas pose sur
  // la frontiere. `k_last` dit lequel est deja parti.
  while (tsw(k_last + 1) < b1 && guard < 64) (
    k = k_last + 1;
    // Au plus proche, pas par troncature : une date exacte relue a 1e-12 sous
    // l'entier tomberait un echantillon trop tot.
    o = floor((tsw(k) - b0) * spb_s + 0.5);
    o < 0 ? ( o = 0; );
    o > samplesblock - 1 ? ( o = samplesblock - 1; );
    fire(k, o);
    k_last = k;
    guard += 1;
  );
  (snd >= 0 && off_at >= 0 && off_at < abs_s + samplesblock) ? note_kill(max(0, off_at - abs_s));
  L = 0; loop(NL, lane_tick(L, b1); L += 1;);
  src == 2 ? ( fb = b1; );
  last_b1 = b1;
) : (
  note_kill(0);
);
last_src = src;
abs_s += samplesblock;
// Les notes recues apres le dernier pas du bloc (ou toutes, a l'arret).
ar_upto(samplesblock);

// ---- les sorties --------------------------------------------------------------
rev >= 1000000 ? ( rev = 0; );
seq_rev = rev;
seq_pha = POS[0] + POS[1] * 16 + POS[2] * 256 + POS[3] * 4096 + POS[4] * 65536;
seq_phb = POS[5] + POS[6] * 16 + POS[7] * 256 + POS[8] * 4096;
seq_state = (src != 0) + (src == 1) * 2 + (snd >= 0) * 4;
seq_moda = seq_on > 0.5 ? sp(7, POS[7]) : 0.5;
seq_modb = seq_on > 0.5 ? sp(8, POS[8]) : 0.5;
seq_note = note_last;
seq_pat = pt_cur;
seq_pmask = pt_mask;
seq_pnext = pt_pend;

// ---- le miroir des patterns, pour Lua -------------------------------------------
// Republie a chaque changement, et quand le canal change (piste dupliquee).
pt_ch = floor(seq_pch + 0.5);
(pt_ch >= 1 && pt_ch <= 255) ? (
  pt_ch != pt_lch ? ( pt_lch = pt_ch; pt_dirty = 1; );
  pt_dirty ? ( pt_publish(); pt_dirty = 0; );
);

// ---- la publication rapide des deux lignes libres ----------------------------
// Tous les 32 echantillons, la valeur de MOD A et de MOD B A LA FIN du sous-pas,
// aux slots 9 et 10 du canal de la piste (Sequencer.FAST_SLOT) ; puis l'en-tete,
// comme la banque CP_Mod : le nombre de sous-pas, leur longueur, et un compteur
// de blocs qui dit au Sound Gen que la memoire vit. Arrete, la ligne tient sa
// valeur -- celle de la sortie.
fon = seq_fch >= 1 && seq_fch <= 255;
fon ? (
  fgb = (seq_fch | 0) * 4096;
  fns = ceil(samplesblock / 32);
  fns > 256 ? ( fns = 256; );
  fns < 1 ? ( fns = 1; );
  fki = 0;
  loop(fns,
    fte = b0 + min((fki + 1) * 32, samplesblock) / spb_s;
    src != 0 ? (
      gmem[fgb + 2064 + fki] = line_at(7, 0, fte);
      gmem[fgb + 2320 + fki] = line_at(8, 1, fte);
    ) : (
      gmem[fgb + 2064 + fki] = seq_moda;
      gmem[fgb + 2320 + fki] = seq_modb;
    );
    fki += 1;
  );
  gmem[fgb] = fns; gmem[fgb + 1] = 32; gmem[fgb + 2] += 1;
);

// ---- l'envoi : nos notes et le MIDI recu, FUSIONNES dans l'ordre des dates ----
i = 0; j = 0;
while (i < evn || j < inn) (
  (j >= inn || (i < evn && EVQ[i * 4] <= INQ[j * 4])) ? (
    e = EVQ + i * 4; i += 1;
  ) : (
    e = INQ + j * 4; j += 1;
  );
  midisend(e[0], e[1], e[2], e[3]);
);

@serialize
// LES PATTERNS VOYAGENT AVEC LE PROJET (les sliders, eux, sont deja sauves par
// REAPER : c'est le pattern courant). Dans l'ordre : la marque, la version, le
// nombre de valeurs par pattern, le courant, le masque, puis chaque pattern
// DEFINI. ⚠ La marque d'abord : un sequenceur d'avant n'a rien ecrit, rien
// n'est lu ni adopte. ⚠ Un pattern range plus court que `PAT_P` (un modele
// anterieur) prend ses valeurs manquantes a leur defaut.
file_avail(0) >= 0 ? (
  s_mk = 0;
  file_var(0, s_mk);
  s_mk == 7301 ? (
    s_ver = 0; s_nv = 0; s_cur = 0; s_msk = 1;
    file_var(0, s_ver); file_var(0, s_nv); file_var(0, s_cur); file_var(0, s_msk);
    s_nv = max(0, min(4096, floor(s_nv + 0.5)));
    s_cur = max(0, min(15, floor(s_cur + 0.5)));
    s_msk = (floor(s_msk + 0.5) & 65535) | (1 << s_cur);
    s_k = 0;
    loop(16,
      ((s_msk >> s_k) & 1) ? (
        s_i = 0;
        loop(s_nv,
          s_x = 0;
          file_var(0, s_x);
          s_i < NPV ? ( PATM[s_k * 256 + s_i] = s_x; );
          s_i += 1;
        );
        while (s_i < NPV) ( PATM[s_k * 256 + s_i] = PDEF[s_i]; s_i += 1; );
      );
      s_k += 1;
    );
    pt_cur = s_cur; pt_mask = s_msk; pt_pend = -1; pt_at = -1;
    pt_ser = 1; pt_dirty = 1;
  );
) : (
  // Le courant d'abord dans sa case : c'est elle qui s'ecrit.
  pt_save(pt_cur);
  s_mk = 7301; s_ver = 1; s_nv = NPV; s_cur = pt_cur; s_msk = pt_mask;
  file_var(0, s_mk); file_var(0, s_ver); file_var(0, s_nv);
  file_var(0, s_cur); file_var(0, s_msk);
  s_k = 0;
  loop(16,
    ((s_msk >> s_k) & 1) ? file_mem(0, PATM + s_k * 256, NPV);
    s_k += 1;
  );
);
