@init
// Pas de @init au lancement du transport : sans ca REAPER le rejoue a chaque
// Play, et l'horloge libre, la note qui sonne et le tirage deja consomme
// repartiraient de zero sous les doigts.
ext_noinit = 1;
NL = 9; NS = 16;
GB = 20; LS = 22;
O_LEN = 16; O_SPD = 17; O_MUT = 18; O_DICE = 19; O_LO = 20; O_HI = 21;

// LA MEMOIRE : des regions a plat, posees une fois.
DEG   = 0;     // 12 : demi-tons de chaque degre de la gamme courante
SPDF  = 16;    // 9  : facteur de vitesse de chaque ligne (relu au bloc)
LENA  = 32;    // 9  : longueur de chaque ligne (relue au bloc)
PCYC  = 48;    // 9  : dernier tour vu par ligne (la mutation)
POS   = 64;    // 9  : le pas courant de chaque ligne
LMIN  = 80;    // 9  : la course de chaque ligne
LMAX  = 96;
LINT  = 112;   // 9  : la ligne est-elle entiere
LBOOL = 128;   // 9  : la ligne est-elle un interrupteur
PPER  = 144;   // 9  : periode vue au bloc precedent
PSPD  = 160;   // 9  : vitesse vue au bloc precedent
SPDT  = 176;   // 9  : la table des vitesses
RATEB = 192;   // 9  : la table des divisions, en noires
EVQ   = 256;   // 64 x 4 : nos evenements du bloc, dans l'ordre des dates
INQ   = 512;   // 256 x 4 : les evenements recus, dans leur ordre
SNAP  = 1536;  // 2 x 16 : les pas des deux lignes libres avant les mutations du bloc
PC0   = 1568;  // 2 : leur tour au debut du bloc
PATM  = 4096;  // 16 x 256 : les seize patterns (Sequencer.PAT_STRIDE)
PATP  = 8192;  // NPV : le slider (1-base) de chaque valeur d'un pattern
PDEF  = 8448;  // NPV : son defaut (un pattern efface)
ARH   = 8704;  // 32 : les notes tenues, dans l'ordre ou elles ont ete jouees
ARS   = 8736;  // 32 : les memes, triees
ARK   = 8768;  // 128 : les touches baissees (le loquet compte les doigts)
ARQ   = 8896;  // 256 x 4 : les notes recues du bloc, pour l'arpege
LMIN[0] = 0; LMAX[0] = 1; LINT[0] = 1; LBOOL[0] = 1;
LMIN[1] = -7; LMAX[1] = 14; LINT[1] = 1; LBOOL[1] = 0;
