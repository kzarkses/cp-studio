t > 0 ? ( v = de[0] * (dm1_in - dm1_ctr); t <= 64 ? ae[t - 1] += v : de[t - 65] += v; );
t = floor(dm2_tgt + 0.5);
t > 0 ? ( v = de[1] * (dm2_in - dm2_ctr); t <= 64 ? ae[t - 1] += v : de[t - 65] += v; );
t = floor(dm3_tgt + 0.5);
t > 0 ? ( v = de[2] * (dm3_in - dm3_ctr); t <= 64 ? ae[t - 1] += v : de[t - 65] += v; );
t = floor(dm4_tgt + 0.5);
t > 0 ? ( v = de[3] * (dm4_in - dm4_ctr); t <= 64 ? ae[t - 1] += v : de[t - 65] += v; );
t = floor(dm5_tgt + 0.5);
t > 0 ? ( v = de[4] * (dm5_in - dm5_ctr); t <= 64 ? ae[t - 1] += v : de[t - 65] += v; );
