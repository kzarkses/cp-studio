t > 0 ? ( v = de[7] * (dm8_in - dm8_ctr); t <= 64 ? ae[t - 1] += v : de[t - 65] += v; );
s = ae[0] * (mix1_in1 - mix1_ctr1) + ae[1] * (mix1_in2 - mix1_ctr2) + ae[2] * (mix1_in3 - mix1_ctr3) + ae[3] * (mix1_in4 - mix1_ctr4);
