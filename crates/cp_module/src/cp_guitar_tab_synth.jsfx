desc:CP Guitar Tab Synth
//tags: instrument synthesizer guitar
//author: CP Studio
// Le son de la tablature de Guitar Tab : quatre sons, une note par corde.
// Les canaux MIDI sont les cordes (canal 1 = la corde aigue). Avec
// "One note per string", une note neuve sur une corde coupe la precedente,
// comme une vraie guitare : un mauvais doigte s'entend.
// Ecrit SANS ecriture scientifique (EEL2 la refuse).

slider1:sound=0<0,3,1{Guitar,Piano,Sine,Bass}>Sound
slider2:tone=0.55<0,1,0.01>Tone
slider3:sustain=1.2<0.1,6,0.1>Sustain (s)
slider4:mono=1<0,1,1{Off,On}>One note per string
slider5:gain_db=-9<-30,6,0.1>Gain (dB)

in_pin:none
out_pin:left
out_pin:right

@init
NV = 16;
BUFLEN = 4096;
// Les voix : des tableaux de NV cases.
v_act = 0;
v_chan = 16;
v_note = 32;
v_freq = 48;
v_len = 64;
v_pos = 80;
v_env = 96;
v_rel = 112;
v_vel = 128;
v_age = 144;
v_lp = 160;
v_snd = 176;
v_t = 192;
v_g = 208;
v_gr = 224;
v_ph = 256;
v_pe = 320;
v_pd = 384;
bufbase = 1024;
evq = bufbase + NV * BUFLEN;
ne = 0;
ei = 0;
scount = 0;

function all_off() local(i) (
  i = 0;
  loop(NV, v_act[i] = 0; i += 1;);
);

function note_off(ch, nt) local(i) (
  i = 0;
  loop(NV,
    (v_act[i] && v_chan[i] == ch && v_note[i] == nt && !v_rel[i]) ? v_rel[i] = 1;
    i += 1;
  );
);

function note_on(ch, nt, vel) local(v, i, best, snd, f, len, b, a, lp, k, mean) (
  v = -1;
  mono ? (
    i = 0;
    loop(NV, (v_act[i] && v_chan[i] == ch) ? v = i; i += 1;);
  );
  v < 0 ? (
    i = 0;
    loop(NV, (v < 0 && !v_act[i]) ? v = i; i += 1;);
  );
  v < 0 ? (
    best = -1;
    v = 0;
    i = 0;
    loop(NV, v_age[i] > best ? (best = v_age[i]; v = i;); i += 1;);
  );
  snd = floor(sound + 0.5);
  f = 440 * 2 ^ (((snd == 3 ? nt - 12 : nt) - 69) / 12);
  v_act[v] = 1;
  v_chan[v] = ch;
  v_note[v] = nt;
  v_freq[v] = f;
  v_vel[v] = vel / 127;
  v_rel[v] = 0;
  v_env[v] = 1;
  v_age[v] = 0;
  v_snd[v] = snd;
  v_t[v] = 0;
  v_lp[v] = 0;
  (snd == 0 || snd == 3) ? (
    // Karplus-Strong : une corde pincee. Le moyennage a deux points retarde
    // d'un demi-echantillon : la longueur le compense.
    len = srate / f - 0.5;
    len > BUFLEN - 2 ? len = BUFLEN - 2;
    len < 2 ? len = 2;
    v_len[v] = len;
    v_pos[v] = 0;
    b = bufbase + v * BUFLEN;
    a = snd == 3 ? 0.12 + tone * 0.3 : 0.2 + tone * 0.75;
    lp = 0;
    mean = 0;
    i = 0;
    loop(BUFLEN, lp += a * ((rand(2) - 1) - lp); b[i] = lp; mean += lp; i += 1;);
    mean /= BUFLEN;
    i = 0;
    loop(BUFLEN, b[i] -= mean; b[i] *= 1.4; i += 1;);
    // La perte par periode : -60 dB en `sustain` secondes ; au relachement,
    // en 80 ms.
    v_g[v] = 10 ^ (-3 / (sustain * f));
    v_gr[v] = 10 ^ (-3 / (0.08 * f));
  ) : (
    // Piano (4 partiels) et sinus : des phases et des enveloppes.
    k = 0;
    loop(4,
      v_ph[v * 4 + k] = 0;
      v_pe[v * 4 + k] = snd == 2 ? (k == 0 ? 1 : 0) : (k == 0 ? 1 : (k == 1 ? 0.5 : (k == 2 ? 0.3 : 0.16))) * (0.5 + tone);
      v_pd[v * 4 + k] = exp(-(1 + k * 1.6) / (sustain * srate));
      k += 1;
    );
  );
);

function voice(v) local(out, snd, b, len, pos, rp, i0, i1, fr, s0, s1, y, fb, k, fk, ph, att) (
  out = 0;
  snd = v_snd[v];
  (snd == 0 || snd == 3) ? (
    b = bufbase + v * BUFLEN;
    len = v_len[v];
    pos = v_pos[v];
    rp = pos - len;
    rp < 0 ? rp += BUFLEN;
    i0 = floor(rp);
    fr = rp - i0;
    i1 = i0 + 1;
    i1 >= BUFLEN ? i1 -= BUFLEN;
    s0 = b[i0];
    s1 = b[i1];
    y = s0 + (s1 - s0) * fr;
    fb = 0.5 * (y + v_lp[v]);
    v_lp[v] = y;
    b[pos] = fb * (v_rel[v] ? v_gr[v] : v_g[v]);
    pos += 1;
    pos >= BUFLEN ? pos = 0;
    v_pos[v] = pos;
    v_rel[v] ? (v_env[v] *= 0.9995);
    out = y * v_env[v];
    (v_t[v] > srate * (sustain * 1.5 + 0.2) || v_env[v] < 0.01) ? v_act[v] = 0;
  ) : (
    k = 0;
    loop(4,
      v_pe[v * 4 + k] > 0.00001 ? (
        fk = v_freq[v] * (k + 1) * (snd == 1 ? 1 + 0.0004 * (k + 1) * (k + 1) : 1);
        ph = v_ph[v * 4 + k] + fk / srate;
        ph >= 1 ? ph -= 1;
        v_ph[v * 4 + k] = ph;
        out += sin(2 * $pi * ph) * v_pe[v * 4 + k];
        v_pe[v * 4 + k] *= snd == 2 ? 0.99999 : v_pd[v * 4 + k];
      );
      k += 1;
    );
    att = v_t[v] / (srate * 0.003);
    att < 1 ? out *= att;
    snd == 1 && v_t[v] < srate * 0.004 ? out += (rand(2) - 1) * 0.15 * tone;
    out *= 0.45;
    v_rel[v] ? v_env[v] *= exp(-1 / (0.07 * srate));
    out *= v_env[v];
    (v_env[v] < 0.0005 || v_pe[v * 4] < 0.0005) ? v_act[v] = 0;
  );
  v_t[v] += 1;
  out * v_vel[v] * (0.35 + 0.65 * v_vel[v]);
);

// La porte du banc d'essai : une note jouee des le depart (0 dans REAPER).
cptest > 0 ? note_on(0, cptest, 110);

@slider
gain = 10 ^ (gain_db / 20);

@block
ne = 0;
ei = 0;
scount = 0;
while (midirecv(ofs, m1, m2, m3)) (
  ne < 255 ? (
    evq[ne * 4] = ofs;
    evq[ne * 4 + 1] = m1;
    evq[ne * 4 + 2] = m2;
    evq[ne * 4 + 3] = m3;
    ne += 1;
  );
  midisend(ofs, m1, m2, m3);
);
i = 0;
loop(NV, v_act[i] ? v_age[i] += 1; i += 1;);

@sample
while (ei < ne && evq[ei * 4] <= scount) (
  st = evq[ei * 4 + 1] & 240;
  ch = evq[ei * 4 + 1] & 15;
  nt = evq[ei * 4 + 2];
  vl = evq[ei * 4 + 3];
  (st == 144 && vl > 0) ? note_on(ch, nt, vl) : (
    (st == 128 || (st == 144 && vl == 0)) ? note_off(ch, nt) : (
      (st == 176 && (nt == 120 || nt == 123)) ? all_off();
    );
  );
  ei += 1;
);
scount += 1;
out = 0;
i = 0;
loop(NV, v_act[i] ? out += voice(i); i += 1;);
out *= gain;
spl0 += out;
spl1 += out;
