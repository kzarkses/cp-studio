// ============================================================================
// UNE SOURCE, UNE AFFINE, UNE CONDITION — TOUTE L'ARITHMETIQUE DES LIAISONS
// ============================================================================
// ⚠ CES TROIS FONCTIONS SONT LA RAISON POUR LAQUELLE UNE ACTION NOUVELLE NE
// COUTE PLUS CINQ ECRITURES. Avant, `kBindMouseX`, `kBindMouseY`, `kBindTime`,
// `kBindOsc` et `kBindValue` repetaient chacun le meme `k * source + c` borne,
// dans cinq branches d'un `switch`. Ajouter la translation aurait demande cinq
// branches de plus — et on en aurait ecrit UNE, celle de la souris, parce que
// c'est celle qu'on avait sous les yeux. La translation ne suivrait alors ni le
// temps ni les cases, et personne ne saurait pourquoi.
// ============================================================================
// LES FORMES, ET C'EST LE MIROIR DE `shapeValue` (LFOPanel.lua)
// ============================================================================
// ⚠ LA PHASE EST EN CYCLES, PAS EN RADIANS. `p = 1` est un tour complet. C'est
// la convention de la banque et de Lua ; la changer ici ferait tourner le point
// six fois trop vite, ce qu'on prendrait pour un probleme de frequence.
//
// ⚠ ET LE RESULTAT VA DE 0 A 1, PAS DE -1 A 1. `kSrcOsc`, lui, rend -1..1.
// Les deux sources voisines n'ont donc PAS le meme domaine, et l'appelant qui
// passe de l'une a l'autre doit refaire son affine. C'est ecrit ici parce que
// c'est exactement ce qu'on oublie.
inline double shape_value(int shape, double p) {
  p = p - std::floor(p);          // fmod positif, pour p negatif aussi
  switch (shape) {
    case 0: return 0.5 + 0.5 * std::sin(p * 6.283185307179586);
    case 1: return (p < 0.5) ? (2.0 * p) : (2.0 - 2.0 * p);
    case 2: return p;
    case 3: return 1.0 - p;
    default: return (p < 0.5) ? 1.0 : 0.0;   // carre
  }
}

inline double src_value(const Bind& b, const Live& L) {
  switch (b.src) {
    case kSrcMouseX: return (double)L.mx;
    case kSrcMouseY: return (double)L.my;
    // Bouton tenu : la souris ; sinon la ou le geste a fini. Voir cp_list.h.
    case kSrcHeldX:  return (double)(L.buttons ? L.mx : L.ux);
    case kSrcHeldY:  return (double)(L.buttons ? L.my : L.uy);
    case kSrcTime:   return L.t;
    case kSrcPlay:   return L.play;
    case kSrcClock:
      if (b.slot < 0 || b.slot >= kClocks) return 0.0;
      return L.clk[b.slot];
    case kSrcValue:
      // ⚠ `val` PEUT ETRE NUL — le harnais hors REAPER n'a pas de cases, et une
      // frame doit rester dessinable sans elles.
      if (!L.val || b.slot < 0 || b.slot >= kSlots) return 0.0;
      return L.val[b.slot];
    case kSrcOsc:
      // ⚠ EXTRAPOLATION EXACTE, PAS LISSAGE. Un signal periodique est
      // entierement decrit par sa frequence et sa phase : entre deux frames
      // Lua, le C++ ne devine pas, il CALCULE. Interpoler entre deux
      // echantillons a 30 Hz ecraserait tout ce qui bouge plus vite que 15 Hz,
      // et le repliement serait invisible a l'oeil comme une simple mollesse.
      return std::sin(6.283185307179586 * b.freq * L.t + b.phase);
    case kSrcShape:
      // ⚠ `freq` EST EN CYCLES PAR SECONDE ET `phase` EN CYCLES. Pas de 2*pi
      // ici, contrairement a la ligne du dessus : `shape_value` prend un tour
      // complet pour p = 1.
      return shape_value(b.shape, b.freq * L.t + b.phase);
    default: return 0.0;
  }
}

// ⚠ LA QUANTIFICATION PORTE SUR LA SOURCE, PAS SUR LE RESULTAT, et c'est ce
// qui la rend juste pour les deux actions a la fois. Quantifier le resultat
// collerait la POSITION sur une grille d'ecran ; quantifier la source colle le
// GESTE sur la grille de l'appelant, puis l'affine le transporte ou il veut --
// une largeur, une abscisse, un alpha. Un seul champ, toutes les actions.
inline double quant(const Bind& b, double v) {
  double q = v;
  if (b.step > 0.0) q = std::floor((v - b.qphase) / b.step) * b.step + b.qphase;
  // Les aimants (ABI 10) : celui qui est plus pres que le point de grille, et a
  // moins du rayon, l'emporte -- la regle de `waveSnap`, a la lettre.
  if (b.mag_n > 0) {
    double bd = std::fabs(q + b.qshift - v);
    const int n = (b.mag_n < Bind::kMaxMag) ? b.mag_n : Bind::kMaxMag;
    for (int i = 0; i < n; ++i) {
      const double d = std::fabs(b.mag[i] - v);
      if (d < bd && d <= b.mag_r) { q = b.mag[i] - b.qshift; bd = d; }
    }
  }
  return q;
}

inline double affine(const Bind& b, const Live& L) {
  double v = b.k * quant(b, src_value(b, L)) + b.c;
  // Le repliement AVANT le bornage : replier apres reviendrait a replier une
  // valeur deja collee au bord, donc a ne jamais reboucler.
  if (b.mod > 0.0) {
    v = std::fmod(v - b.lo, b.mod);
    if (v < 0.0) v += b.mod;
    v += b.lo;
  }
  if (b.lo < b.hi) { if (v < b.lo) v = b.lo; if (v > b.hi) v = b.hi; }
  // ⚠ UNE LIAISON REND TOUJOURS UN NOMBRE FINI (le socle, lot 2). `k` et `c`
  // sont finis a la pose, mais leur produit par une source peut deborder : un
  // NaN vaut la borne basse, et rien ne depasse `kValMax`. Les coordonnees sont
  // bornees plus serre la ou elles sont ecrites (`apply_one`, `walk_at`).
  if (v != v) {
    health::bump(health::kBindNonFinite);
    v = (b.lo < b.hi) ? b.lo : 0.0;
  }
  return sane::clamp(v, sane::kValMax, nullptr);
}

// La valeur d'une portee de DEPLACEMENT : une translation, donc une
// coordonnee. Bornee comme elle, pour que seize translations empilees et une
// largeur tiennent dans un `int` (voir cp_sane.h).
inline double move_of(const Bind& b, const Live& L) {
  return sane::coord(affine(b, L));
}

// La condition d'une portee. `inv` retourne le sens : « visible quand la souris
// est dedans » et « cache quand elle est dedans » sont tous deux demandes —
// une infobulle et un libelle qu'un survol remplace.
//
// ⚠⚠ ET LE RECTANGLE SUIT LA TRANSLATION QUI LE PORTE. Une rangee de liste est
// decrite a la position CIBLE du defilement, pas a celle qu'on montre : pendant
// que la liste glisse, le rectangle de survol serait reste sur la cible, donc
// devant la rangee du dessous. On aurait vu s'allumer une rangee qui n'est pas
// sous le curseur — et le defaut aurait disparu des que la liste s'immobilise,
// ce qui est la pire facon de le chercher.
//
// On decale la SOURIS a l'envers plutot que le rectangle : c'est le meme
// resultat en deux soustractions au lieu de quatre, et surtout ca ne touche pas
// la liaison, qui reste la description que Lua a donnee.
inline bool cond_holds(const Bind& b, const Live& L, double ox, double oy) {
  const int mx = L.mx - (int)ox, my = L.my - (int)oy;
  const bool in = inside(b, mx, my);
  return b.inv ? !in : in;
}
inline bool cond_holds(const Bind& b, const Live& L) {
