/*@@ LIGNE MANQUANTE @@*/
/*@@ LIGNE MANQUANTE @@*/
/*@@ LIGNE MANQUANTE @@*/
/*@@ LIGNE MANQUANTE @@*/
/*@@ LIGNE MANQUANTE @@*/
/*@@ LIGNE MANQUANTE @@*/
/*@@ LIGNE MANQUANTE @@*/
/*@@ LIGNE MANQUANTE @@*/
/*@@ LIGNE MANQUANTE @@*/
/*@@ LIGNE MANQUANTE @@*/
/*@@ LIGNE MANQUANTE @@*/
  // ⚠ LA FACTICE D'ABORD. Une poignee perimee mene ici (`select_win`), et le
  // script appelle alors `CP_UIClose` sur elle : arreter le fil avant ce test
  // figeait toutes les AUTRES fenetres, sans jamais le redemarrer.
  Win* w = g_cur;
  if (w == &g_nowin) return;
  stop_worker();

  // LE BILAN DU CLAVIER HEBERGE. Les lignes « premiere fois » disent qu'un
  // chemin a servi ; celle-ci dit COMBIEN, donc si une touche se perd entre deux
  // etapes. Une fenetre jamais hebergee ne dit rien.
  if (w->kn_hand || w->kn_read || w->kn_pass) {
    cp::log::line("clavier : bilan de \"%s\" -- %d touches remises par le crochet, "
                  "%d lues par Lua, %d rendues a REAPER (%d avec une action)",
                  w->title, w->kn_hand, w->kn_read, w->kn_pass, w->kn_hit);
  }

  if (w->hwnd) {
    HWND h = w->hwnd;
    // ⚠ RETIRER DU DOCKER AVANT DE DETRUIRE. Dans l'autre sens, REAPER
    // garde une reference vers une fenetre morte, et c'est lui qui tombe.
    if (DockWindowRemove) DockWindowRemove(h);
    w->hwnd = nullptr;
    DestroyWindow(h);
  }

  if (w->bm && LICE__Destroy) LICE__Destroy(w->bm);
  if (w->bm_back && LICE__Destroy) LICE__Destroy(w->bm_back);
  drop_win(w);

  // ⚠ LA COURANTE DEVIENT LA FACTICE, PLUS UNE SURVIVANTE. Une survivante,
  // c'etait la fenetre d'un autre script offerte au prochain ordre qui
  // arriverait sans selection. Chaque appelant selectionne avant d'agir.
  g_cur = &g_nowin;
  bool any = false;
  for (int i = 0; i < kMaxWin; ++i) if (g_wins[i]) { any = true; break; }
  if (any && !g_closing_all) start_worker();
}

// ⚠ ELLE REND FAUX DES QUE LA FERMETURE EST DEMANDEE, pas seulement
// quand le HWND est mort. C'est ce qui fait rendre -1 a `gfx.getchar` et donc
// arreter la boucle `defer` du script -- la seule facon propre de fermer une
// fenetre depuis Windows, parce qu'elle laisse Lua sauver son etat.
bool is_open() { return W.hwnd != nullptr && !W.close_req; }

// ⚠⚠ UN ONGLET CACHE DESSINAIT ENCORE TOUT, TRENTE FOIS PAR SECONDE.
// Presque toutes les fenetres de la suite coupent le ralenti d'inactivite
// (`idle_throttle = false`) : leur boucle fait une frame pleine a chaque tick,
// et rien ne demandait si quelqu'un la voyait. Un onglet de docker qu'on ne
// regarde pas, un docker ferme, REAPER reduit : la frame etait decrite,
// publiee, composee -- pour personne.
//
// Le docker de REAPER CACHE l'enfant d'un onglet inactif (ShowWindow), donc
// `IsWindowVisible` le dit, y compris quand c'est un ANCETRE qui est cache.
// Une fenetre principale reduite reste « visible » pour Windows : la racine
// se demande a part.
//
// ⚠ ELLE NE DIT RIEN DE LA LOGIQUE. Une fenetre cachee continue de tourner --
// la Session doit relancer ses cases sous un onglet qu'on ne regarde pas.
// C'est Lua qui decide de ne plus DESSINER (`Core.Run`), pas la DLL de ne plus
// appeler.
bool shown() {
  if (!W.hwnd || !IsWindowVisible(W.hwnd)) return false;
  HWND root = GetAncestor(W.hwnd, GA_ROOT);
  return !(root && IsIconic(root));
}

// La fenetre courante prend-elle le clavier au clic ? Voir `Win::keyless`.
// ⚠ EN LE RALLUMANT, ON LACHE AUSSI CE QU'ELLE TENAIT. Lua l'eteint le temps
// d'une saisie, et la fenetre a pu revendiquer le clavier entre-temps ; sans
// cette ligne, le crochet continuerait a lui readresser les touches de
// l'arrangeur alors qu'elle ne veut plus en recevoir. Le FOCUS, lui, est rendu
// par Lua : il sait a qui il l'a pris.
//
// ⚠ ET EN L'ETEIGNANT, ELLE REVENDIQUE -- LE TEMPS DE LA SAISIE. Le dernier
// clic l'emporte sur le focus (`route_key`) : sans revendication, taper un
// tempo dans CP_Transport apres avoir clique dans l'editeur aurait envoye les
// chiffres a l'editeur. La revendication d'avant est gardee et RENDUE au
// rallumage : l'editeur retrouve son clavier une fois le tempo tape.
HWND g_kbd_claim_saved = nullptr;
void set_keyless(bool on) {
  if (W.keyless == on) return;
  W.keyless = on;
  if (!W.hwnd) return;
  if (!on) {
    g_kbd_claim_saved = (g_kbd_claim != W.hwnd) ? g_kbd_claim : nullptr;
    g_kbd_claim = W.hwnd;
    g_kbd_claim_ms = GetTickCount64();
    g_kbd_reclaims = 0;
  } else if (g_kbd_claim == W.hwnd) {
    HWND back = g_kbd_claim_saved;
    g_kbd_claim = (back && IsWindow(back) && ours(back)) ? back : nullptr;
    g_kbd_claim_saved = nullptr;
  }
}

const char* diag() {
  update_diag(W);
  return W.diag;
}

// ---------------------------------------------------------------------------
// LE DESSIN PILOTE DEPUIS LUA
// ---------------------------------------------------------------------------
// ⚠ AUCUNE LISTE D'AFFICHAGE. Chaque ordre compose IMMEDIATEMENT dans la
// bitmap. Une liste couterait une allocation par frame et un parcours de plus,
// pour un gain nul : la traversee Lua->C est deja payee au moment ou l'ordre
// arrive, et c'est ELLE qu'on cherche a economiser, pas le dessin.
// ---------------------------------------------------------------------------
// LE REJEU
// ---------------------------------------------------------------------------
// ⚠ C'EST DESORMAIS LA SEULE CHOSE QUI DESSINE. Les fonctions `draw_*`
// ENREGISTRENT ; plus une seule ne compose. La consequence qui compte n'est pas
// la performance, c'est que la fenetre sait se redessiner SANS Lua — pendant un
// redimensionnement, ou a la cadence de l'ecran.

void replay_text(const Surface& s, int x, int y, const char* str,
                 unsigned int col, int size) {
  if (!str) return;
  // ⚠ `size` EST UN INDICE D'ATLAS, PAS UNE TAILLE EN PIXELS. Le nom est reste
  // de l'epoque ou il n'y en avait que trois ; le changer partout ferait un
  // diff illisible pour un gain nul, mais l'oublier ferait chercher une police
  // de 3 pixels.
  const int fi = (size < 0 || size >= kMaxFont) ? 1 : size;
  const Atlas& a = g_fonts[fi].at;
  // ⚠ L'ALPHA EST L'OCTET HAUT DE LA COULEUR. `gfx` fond un texte a `gfx.a` ;
  // le miroir natif l'a longtemps JETE (`col()` posait 0xFF), donc toute
  // etiquette attenuee -- un libelle a 0,4, une icone-texte a 0,82 -- sortait
  // opaque, et aucun survol par l'alpha ne pouvait exister sur un texte.
  if (a.ready) { atlas_draw(s, a, x, y, str, col, (col >> 24) & 0xFFu); return; }

  // ⚠ LE REPLI EXISTE, ET IL EST INFERIEUR. Si la cuisson a echoue — une police
  // absente, un pilote qui refuse `GGO_GRAY8_BITMAP` — on repasse par GDI, avec
  // le decoupage tout-ou-rien qu'il impose et l'interdit de dessiner depuis un
  // autre fil. La fenetre reste lisible plutot que muette, et la ligne d'etat
  // DIT lequel des deux chemins sert.
  if (y + 40 <= s.cy || y >= s.cy + s.ch) return;
  if (x >= s.cx + s.cw) return;
  LICE_IFont* f = (size >= 2) ? g_font_l : (size == 1 ? g_font : g_font_s);
  if (!f || !LICE__DrawText || !LICE__SetTextColor) return;
  LICE__SetTextColor(f, col);
  if (LICE__SetBkColor) LICE__SetBkColor(f, 0);
  RECT r;
  r.left = x; r.top = y;
  r.right  = (x + 600 < s.cx + s.cw) ? (x + 600) : (s.cx + s.cw);
  r.bottom = (y + 40  < s.cy + s.ch) ? (y + 40)  : (s.cy + s.ch);
  if (r.right <= r.left || r.bottom <= r.top) return;
  LICE__DrawText(f, g_text_bm ? g_text_bm : W.bm, str, (int)strlen(str), &r,
                 DT_LEFT | DT_TOP | DT_SINGLELINE);
}

// La couleur de fond de la frame : celle du PREMIER rectangle plein qui couvre
// l'origine. Sert au redimensionnement — la zone qui vient d'apparaitre doit
// naitre a la couleur du theme, pas en noir.
unsigned int background_of(const cp::list::Frame& f) {
  for (int i = 0; i < f.n_cmd; ++i) {
    const cp::list::Cmd& c = f.cmd[i];
    if (c.op == cp::list::kOpRect && c.i0 >= 255 &&
        c.d[0] <= 0.0 && c.d[1] <= 0.0 && c.d[2] > 0.0 && c.d[3] > 0.0)
      return c.c0;
  }
  return 0xFF000000u;
}

// ⚠ L'HORLOGE ET L'AMORTISSEMENT VIVENT ICI, PAS DANS LA LIAISON. Une liaison
// est evaluee une fois par ordre ; la descente d'un metre doit avancer une fois
// par COMPOSITION. Les melanger ferait descendre un metre d'autant plus vite
// qu'il est dessine plusieurs fois — un defaut qui ne se voit qu'en ajoutant un
// second element a l'ecran.
void update_clock(Win& wn) {
  const long long now = qpc_now();
  if (!wn.t_open) { wn.t_open = now; wn.t_decay = now; }
  wn.live.t = (g_qpf > 0) ? (double)(now - wn.t_open) / (double)g_qpf : 0.0;

  double dt = (g_qpf > 0) ? (double)(now - wn.t_decay) / (double)g_qpf : 0.0;
  wn.t_decay = now;
  // Une fenetre reduite ou une boucle modale rendent un intervalle enorme : on
  // ne fait alors PAS descendre le metre d'un coup, on repart de zero.
  if (dt < 0.0 || dt > 0.5) dt = 0.0;

  // ============================================================================
  // DEUX LOIS, ET LES CONFONDRE COUTE UNE SOIREE
  // ============================================================================
  // ⚠ CELLE D'ORIGINE EST CELLE D'UN VU-METRE : attaque instantanee, descente
  // exponentielle VERS ZERO. C'est exactement ce qu'il faut pour un niveau, et
  // c'est FAUX pour tout ce qui glisse vers une cible. Un defilement amorti par
  // cette loi-la sauterait d'un coup en descendant et ramperait vers le HAUT DE
  // LA LISTE en remontant — parce que « vers zero » n'est pas « vers la
  // valeur ». Le symptome est asymetrique, donc on le prend pour un probleme
  // d'entree avant de le prendre pour un probleme de lissage.
  //
  // La seconde est un simple passe-bas symetrique : `montre += (cible -
  // montre) * (1 - exp(-dt/tau))`. C'est ce qu'il faut des qu'une valeur a une
  // CIBLE plutot qu'un PIC.
  //
  // ⚠ LE MODE ZERO RESTE LE METRE. Toute case existante garde sa loi sans que
  // personne n'ait a le savoir : un defaut de cette famille se paie autrement.
  for (int i = 0; i < cp::list::kSlots; ++i) {
    const double tau = wn.tau[i];
    if (tau <= 0.0) { wn.shown[i] = wn.val[i]; continue; }
    const double k = std::exp(-dt / tau);
    if (wn.mode[i] == 1) {
      wn.shown[i] = wn.val[i] + (wn.shown[i] - wn.val[i]) * k;
      // Sous le demi-millieme d'unite, on colle : sinon la case ne CONVERGE
      // jamais tout a fait, `damage` la voit changer a chaque composition, et
      // la fenetre ne redescend plus jamais au repos. Un lissage qui empeche le
      // repos coute plus cher que ce qu'il embellit.
      const double d = wn.shown[i] - wn.val[i];
      if (d < 0.0005 && d > -0.0005) wn.shown[i] = wn.val[i];
    } else {
      double v = wn.shown[i] * k;
      if (wn.val[i] > v) v = wn.val[i];   // l'attaque est instantanee
      wn.shown[i] = v;
    }
  }
  wn.live.val = wn.shown;
}

// ============================================================================
// LE COMPOSITEUR — UN SEUL, ET C'EST TOUT LE MODELE
// ============================================================================
// Quand le fil de rejeu existe, il est le SEUL a appeler ceci. Le fil principal
// ne compose plus : il pose une frame, leve `W.dirty`, et s'en va. C'est ce qui
// supprime toute contention entre les deux — le seul verrou que le fil principal
// prend encore est celui du blit, et il dure un dixieme de milliseconde.
//
// ⚠ ON EFFACE TOUJOURS LE TAMPON ARRIERE. Avec un double tampon, l'arriere
// contient l'avant-derniere image : une frame qui ne couvre pas toute la
// fenetre laisserait paraitre celle d'il y a deux compositions. Le cout est
// 0,024 ms — le prix de ne jamais avoir a se demander si l'appelant a couvert.
void compose_win(Win& wn, bool notify) {
  // Le fil demarre a l'ouverture, donc AVANT la premiere frame Lua : la liste
  // est alors vide, et composer vide peint le fond par defaut. C'est voulu.
  if (!wn.hwnd) return;
  RECT rc; GetClientRect(wn.hwnd, &rc);
  const int w = rc.right - rc.left, h = rc.bottom - rc.top;
  if (w < 2 || h < 2) return;

  // ⚠ LES CASES VIDEO NE SE LIBERENT PAS PENDANT QU'ON COMPOSE (ABI 4.1). Le
  // rejeu blitte l'avant d'une case a travers `img_provider` ; le fil principal
  // qui la delie ou la redimensionne prend ce verrou en ecriture et attend donc
  // la fin de la composition. En lecture, il ne bloque ni la camera ni le
  // robinet, qui publient pendant ce temps dans leurs tampons arriere.
  struct VideoRead {
    VideoRead()  { cp::video::begin_read(); }
    ~VideoRead() { cp::video::end_read(); }
  } video_read;

  // `live` appartient au fil de rejeu : la souris y a ete sondee par la passe
  // (`poll_mouse`), l'horloge et les cases s'y posent ici. Sans fil, c'est le
  // fil principal qui compose, et il sonde lui-meme.
  if (!g_thread) { int mx, my; if (poll_mouse(wn, &mx, &my)) { wn.live.mx = mx; wn.live.my = my; } }
  update_clock(wn);
  wn.live.buttons = wn.mb;
  // La fin du dernier geste, lue APRES `mb` (voir `note_release`).
  std::atomic_thread_fence(std::memory_order_acquire);
  wn.live.ux = wn.gup_x; wn.live.uy = wn.gup_y;
  cp::list::Live live = wn.live;
  live.val = wn.shown;

  bool fresh = false;
  int dres = -1;   // le diff : -1 pas fait, 0 identique, 1 une boite, 2 tout
  int dx0 = 0, dy0 = 0, dx1 = w, dy1 = h;
  // L'autre bout de la publication : meme verrou COURT que `end_frame`, et
  // surtout pas celui des tampons -- sinon on aurait juste deplace l'attente.
  bool spilled = false;
  if (g_cs_ok) EnterCriticalSection(&g_cs_pub);
  if (wn.spill_new) {
    // La frame rattrapee : son ETAT seul (les cuissons), pas ses pixels. Sous
    // le verrou, parce que `end_frame` pourrait la remplacer ; quelques dizaines
    // de microsecondes par icone cuite, et seulement quand ca arrive.
    cp::list::replay(*wn.spill, gfx::Surface(), &replay_text, nullptr,
                     wn.imgs, cp::list::kMaxImg, &img_provider, &wn, true);
    wn.spill_new = false;
    spilled = true;
  }
  if (wn.ready_new) {
    cp::list::Frame* t = wn.play; wn.play = wn.ready; wn.ready = t;
    wn.ready_new = false;
    fresh = true;
  }
  // ⚠ LE DIFF SE FAIT SOUS LE VERROU DE PUBLICATION. `ready` est maintenant
  // l'ancienne frame -- celle qui est A L'ECRAN -- et Lua ne doit pas
  // l'echanger pendant qu'on la lit. Quelques dizaines de microsecondes : c'est
  // le seul moment ou `end_frame` peut attendre ici, et il n'attend jamais une
  // rasterisation.
  // ⚠ PAS DE DIFF DERRIERE UNE FRAME RATTRAPEE : ses cuissons ont pu
  // redessiner une image que la frame neuve blitte par un ordre identique a
  // l'ancien, et le diff ne verrait rien.
  if (fresh && !spilled && g_diff_on && wn.replays > 0 && wn.bm_w == w && wn.bm_h == h)
    dres = cp::list::diff(*wn.ready, wn.live_drawn, *wn.play, live,
                          &dx0, &dy0, &dx1, &dy1);
  if (g_cs_ok) LeaveCriticalSection(&g_cs_pub);

  // ==========================================================================
  // LES IMAGES NEUVES DES CASES VIDEO (ABI 4.1)
  // ==========================================================================
  // Un autre fil a remplace les pixels d'une case : aucune liaison n'a bouge,
  // et l'ordre de blit est le meme d'une frame Lua a l'autre -- ni `damage` ni
  // `diff` ne peuvent le voir. On prend les images fraiches (elles passent a
  // l'AVANT, que le rejeu blittera) et on salit la boite des blits qui les
  // montrent, et rien d'autre : une camera a 30 i/s dans un coin de la fenetre
  // coute ce coin, pas la fenetre.
  int vids[8];
  int vx0 = 0, vy0 = 0, vx1 = 0, vy1 = 0;
  const int nv = cp::video::acquire(&wn, vids, 8);
  const bool vdmg = nv > 0 &&
      cp::list::img_damage(*wn.play, live, vids, nv < 8 ? nv : 8, &vx0, &vy0, &vx1, &vy1);

  // ==========================================================================
  // CE QUI A CHANGE, PAS CE QU IL FAUDRAIT REDESSINER
  // ==========================================================================
  // Sans ce bloc, deplafonner veut dire recomposer la fenetre ENTIERE 120 fois
  // par seconde. Sur FX Constellation - 1400 x 800 - c est 134 millions de
  // pixels par seconde a effacer, redessiner et recopier, pour un survol qui en
  // change cent. La cible est un PC de 2005 : on aurait << gagne >> des fps en
  // perdant la machine.
  //
  // Seule une LIAISON peut faire differer deux compositions de la meme frame.
  // On demande donc a la liste ce que les liaisons changent entre l etat
  // compose la derniere fois et celui de maintenant. Trois consequences :
  //   - survoler un bouton coute la boite du bouton ;
  //   - un metre dont le niveau a fini de descendre CESSE de couter, tout seul ;
  //   - quand rien ne change, ON NE COMPOSE PAS. Une fenetre que personne ne
  //     touche coute zero, meme avec le fil a 120 Hz - c est ce qui permet d en
  //     ouvrir seize sans y penser.
  //
  // ⚠ UNE FRAME NEUVE N'EST PLUS UNE COMPOSITION PLEINE D'OFFICE. Elle l'etait
  // -- « Lua peut avoir tout change sans qu'aucune liaison ne bouge » -- et
  // c'etait vrai, mais ca coutait la fenetre entiere trente fois par seconde
  // par fenetre active, toutes publiees dans le meme tick. `cp::list::diff`
  // compare maintenant ce qui est montre a ce qui est vrai, ordre par ordre :
  // identique, on ne compose rien ; une boite, on la retouche ; un ordre
  // d'etat qui differe ou une frame tronquee, on repasse en plein. Un
  // redimensionnement repasse toujours en plein.
  bool full = wn.replays == 0 || wn.bm_w != w || wn.bm_h != h;
  if (fresh) {
    if (dres == 0 && !vdmg) {
      // La frame neuve montre EXACTEMENT ce qui est deja a l'ecran : rien a
      // composer. Ce qu'on a montre est desormais decrit par elle, sous
      // l'etat de maintenant.
      wn.live_drawn = live;
      std::memcpy(wn.drawn_val, wn.shown, sizeof wn.drawn_val);
      wn.live_drawn.val = wn.drawn_val;
      ++wn.diff_same;
      return;
    }
    // Seule une case video a change : sa boite. Les deux : l'union.
    if (dres == 0) { dres = 1; dx0 = vx0; dy0 = vy0; dx1 = vx1; dy1 = vy1; }
    else if (dres == 1 && vdmg) {
      if (vx0 < dx0) dx0 = vx0; if (vy0 < dy0) dy0 = vy0;
      if (vx1 > dx1) dx1 = vx1; if (vy1 > dy1) dy1 = vy1;
    }
    if (dres == 1) { ++wn.diff_box; }
    else { full = true; dx0 = 0; dy0 = 0; dx1 = w; dy1 = h; }
    // ⚠ LE FILET. L'endommagement est exact par construction et prouve par
    // le harnais ; une trainee qui echapperait quand meme a un calcul ne
    // s'effacerait JAMAIS, parce que rien ne repeint ce que rien ne salit. Une
    // composition pleine par demi-seconde de frames Lua neuves -- deux par
    // seconde pendant un geste, zero au repos -- borne la vie d'une trainee
    // sans rien couter qui se mesure. La ligne d'etat les compte.
    if (!full && g_qpf > 0 && wn.t_last_full &&
        (double)(qpc_now() - wn.t_last_full) / (double)g_qpf > 0.5) {
      full = true; dx0 = 0; dy0 = 0; dx1 = w; dy1 = h;
      ++wn.nets;
    }
  } else if (!full) {
    const bool dmg = cp::list::damage(*wn.play, live, wn.live_drawn, &dx0, &dy0, &dx1, &dy1);
    if (!dmg && !vdmg) {
      // Rien ne change entre les deux etats : les pixels montres valent aussi
      // pour celui de maintenant, et on le note pour ne pas refaire ce calcul a
      // chaque passe tant que la souris bouge dans le vide.
      wn.live_drawn = live;
      std::memcpy(wn.drawn_val, wn.shown, sizeof wn.drawn_val);
      wn.live_drawn.val = wn.drawn_val;
      return;
    }
    if (!dmg) { dx0 = vx0; dy0 = vy0; dx1 = vx1; dy1 = vy1; }
    else if (vdmg) {
      if (vx0 < dx0) dx0 = vx0; if (vy0 < dy0) dy0 = vy0;
      if (vx1 > dx1) dx1 = vx1; if (vy1 > dy1) dy1 = vy1;
    }
  }
  if (!full) {
    // AU-DELA DES DEUX TIERS, LE PLEIN COUTE MOINS CHER QUE LE PARTIEL. Le
    // partiel tient le verrou d echange pendant qu il rasterise ; le plein
    // travaille dans le tampon arriere, donc sans verrou, et ne le prend que
    // pour echanger. Sur une grande zone, laisser `paint` attendre coute plus
    // que les pixels economises.
    const double area = (double)(dx1 - dx0) * (double)(dy1 - dy0);
    if (area > 0.66 * (double)w * (double)h) {
      full = true; dx0 = 0; dy0 = 0; dx1 = w; dy1 = h;
    }
  }

  const long long t0 = qpc_now();
  if (full) {
    if (!ensure_bm(wn.bm_back, wn.bmb_w, wn.bmb_h, w, h)) return;
    Surface s = surface_of(wn.bm_back, wn.bmb_w, wn.bmb_h);
    if (!s.px) return;
    fill_rect(s, 0, 0, s.w, s.h, background_of(*wn.play), 255);
    g_text_bm = wn.bm_back;
    cp::list::replay(*wn.play, s, &replay_text, &live, wn.imgs,
                     cp::list::kMaxImg, &img_provider, &wn);
    g_text_bm = nullptr;
    if (g_cs_ok) EnterCriticalSection(&g_cs_front);
    { LICE_IBitmap* tb = wn.bm; wn.bm = wn.bm_back; wn.bm_back = tb;
      const int tw = wn.bm_w; wn.bm_w = wn.bmb_w; wn.bmb_w = tw;
      const int th = wn.bm_h; wn.bm_h = wn.bmb_h; wn.bmb_h = th; }
    if (g_cs_ok) LeaveCriticalSection(&g_cs_front);
  } else {
    // ========================================================================
    // LE PARTIEL ECRIT DANS LE TAMPON AVANT, PAS DANS L ARRIERE
    // ========================================================================
    // Avec un double tampon, l arriere contient l avant-derniere image. Y poser
    // une retouche puis echanger montrerait cette image-la partout ailleurs :
    // la fenetre reculerait d une frame a chaque survol. On retouche donc celle
    // qui est deja a l ecran.
    //
    // SOUS LE VERROU, DONC PENDANT LA RASTERISATION - ce que la composition
    // pleine s interdit. C est acceptable ICI et seulement ici : la zone est
    // petite par construction (au-dela des deux tiers on repasse en plein), donc
    // `paint` n attend jamais longtemps. Le seuil plus haut n est pas un reglage
    // de confort, c est ce qui borne cette attente.
    if (g_cs_ok) EnterCriticalSection(&g_cs_front);
    Surface s = surface_of(wn.bm, wn.bm_w, wn.bm_h);
    if (s.px) {
      surface_clip(s, dx0, dy0, dx1 - dx0, dy1 - dy0);
      fill_rect(s, dx0, dy0, dx1 - dx0, dy1 - dy0, background_of(*wn.play), 255);
      g_text_bm = wn.bm;
      cp::list::replay(*wn.play, s, &replay_text, &live, wn.imgs,
                       cp::list::kMaxImg, &img_provider, &wn);
      g_text_bm = nullptr;
    }
    if (g_cs_ok) LeaveCriticalSection(&g_cs_front);
  }
  if (g_qpf > 0) {
    const double ms = 1000.0 * (double)(qpc_now() - t0) / (double)g_qpf;
    wn.ms_avg = (wn.replays == 0) ? ms : (wn.ms_avg * 0.9 + ms * 0.1);
  }

  // ⚠ ON COPIE LES VALEURS, PAS LEUR ADRESSE. Voir `drawn_val` : sans ce
  // memcpy, `live_drawn.val` pointerait sur le tableau vivant et la comparaison
  // se ferait contre elle-meme.
  wn.live_drawn = live;
  std::memcpy(wn.drawn_val, wn.shown, sizeof wn.drawn_val);
  wn.live_drawn.val = wn.drawn_val;
  wn.bm_dirty = false;
  ++wn.replays;
  if (full) { ++wn.fulls; wn.t_last_full = qpc_now(); }

  // ============================================================================
  // ⚠⚠ ON PRESENTE, ON NE SE CONTENTE PAS DE MARQUER LA FENETRE
  // ============================================================================
  // C'ETAIT LE BRIDAGE, ET IL ETAIT ENTIER. Ce fil composait bien a la cadence
  // de l'ecran ; il posait ensuite `InvalidateRect`, qui ne fait que MARQUER la
  // fenetre sale. Le pixel n'arrive a l'ecran que par `WM_PAINT` — et `WM_PAINT`
  // est le message le MOINS prioritaire de Windows : il n'est delivre que quand
  // la file est vide par ailleurs.
  //
  // Or la file n'est jamais vide au moment ou ca compte : bouger la souris la
  // remplit de `WM_MOUSEMOVE`, et c'est precisement pendant qu'on bouge la
  // souris qu'on veut voir le survol suivre. Tout le mecanisme — les liaisons,
  // le rejeu, le calcul sans Lua — aboutissait donc a une image posee dans un
  // tampon que personne ne montrait avant le prochain temps mort.
  //
  // Le compositeur presente donc lui-meme, par le meme `BitBlt` que `paint`.
  // ⚠ SOUS LE MEME VERROU QUE L'ECHANGE : c'est exactement ce pour quoi il
  // existe, et c'est ce qui empeche `paint` de blitter un tampon qu'on est en
  // train d'echanger. Le verrou reste tenu quelques dixiemes de milliseconde,
  // jamais pendant la composition.
  // La zone composee, gardee pour la presentation — qu'elle parte tout de
  // suite (pas de fil de rejeu) ou au prochain balayage (fil de rejeu).
  // ⚠ ON UNIT, ON N'ECRASE PAS. Une fenetre peut etre composee deux fois dans
  // la meme passe (un partiel, puis la frame Lua qui vient d'arriver) : la
  // zone du premier, si elle n'a pas encore ete presentee, doit partir avec
  // celle du second. L'ecraser laisserait des pixels justes dans le tampon et
  // faux a l'ecran, jusqu'au prochain redessin de cette zone.
  if (wn.pres_due) {
    if (dx0 < wn.pres_x0) wn.pres_x0 = dx0;
    if (dy0 < wn.pres_y0) wn.pres_y0 = dy0;
    if (dx1 > wn.pres_x1) wn.pres_x1 = dx1;
    if (dy1 > wn.pres_y1) wn.pres_y1 = dy1;
  } else {
    wn.pres_x0 = dx0; wn.pres_y0 = dy0; wn.pres_x1 = dx1; wn.pres_y1 = dy1;
  }
  wn.pres_due = true;
  if (notify) present_win(wn);
}

// ⚠ LE BLIT, ET RIEN D'AUTRE. Il tient le verrou d'echange le temps d'une
// recopie — c'est exactement ce pour quoi ce verrou existe, et c'est ce qui
// empeche `paint` de blitter un tampon qu'on est en train d'echanger.
//
// ON NE RECOPIE QUE CE QU'ON A REDESSINE. Recopier toute la fenetre apres une
// retouche de cent pixels rendrait le calcul d'endommagement inutile : le
// `BitBlt` est le poste le plus cher du chemin, pas le rasteriseur.
void present_win(Win& wn) {
  if (!wn.pres_due) return;
  wn.pres_due = false;
  if (!wn.hwnd || !LICE__GetDC) return;
  if (g_cs_ok) EnterCriticalSection(&g_cs_front);
  HDC dst = GetDC(wn.hwnd);
  if (dst) {
    HDC src = LICE__GetDC(wn.bm);
    if (src) BitBlt(dst, wn.pres_x0, wn.pres_y0,
                    wn.pres_x1 - wn.pres_x0, wn.pres_y1 - wn.pres_y0,
                    src, wn.pres_x0, wn.pres_y0, SRCCOPY);
    ReleaseDC(wn.hwnd, dst);
  }
  if (g_cs_ok) LeaveCriticalSection(&g_cs_front);
  InterlockedIncrement(&wn.pres_n);
}

// ============================================================================
// LE FIL DE REJEU
// ============================================================================
// ⚠ `DwmFlush` BLOQUE JUSQU'AU BALAYAGE SUIVANT. C'est ce qui rend la cadence
// EXACTE plutot que « environ 120 fois par seconde » : sur un ecran a 120 Hz,
// chaque image tient exactement un balayage. Un `SetTimer` a 8 ms donnerait 3,
// puis 5, puis 4 — et l'irregularite se voit PLUS qu'un 30 Hz stable.
//
// ⚠ IL EST CHARGE DYNAMIQUEMENT. Lier `dwmapi.lib` ferait dependre la DLL de sa
// presence au chargement ; ici son absence coute un `Sleep(4)` et rien d'autre.
//
// ⚠ ET IL N'EST DEMARRE QUE SI L'ATLAS EST CUIT. Sans atlas, le texte repasse
// par un `HDC` GDI, qui ne se partage pas entre deux fils. Le repli n'est donc
// pas « moins joli », il est INTERDIT au fil — d'ou la garde, et d'ou la ligne
// d'etat qui dit lequel des deux chemins sert.
// Presente tout de suite si la passe en a le temps, sinon a la suivante.
void maybe_present(Win& wn, long long t_flush) {
  if (!wn.pres_due) return;
  const double period = (g_vsync_hz > 1.0) ? (1.0 / g_vsync_hz) : (1.0 / 60.0);
  const double el = (g_qpf > 0) ? (double)(qpc_now() - t_flush) / (double)g_qpf : 1.0;
  if (!g_present_late && el < kPresentBudget * period) {
    present_win(wn);
    ++wn.pres_now;
  } else {
    ++wn.pres_late;
  }
}

unsigned __stdcall vsync_worker(void*) {
  long long last = 0;
  int last_w[kMaxWin], last_h[kMaxWin];
  bool resized[kMaxWin];
  // Montree a cette passe, et cachee a la precedente : voir plus bas.
  bool vis[kMaxWin], was_hidden[kMaxWin];
  for (int i = 0; i < kMaxWin; ++i) {
    last_w[i] = -1; last_h[i] = -1; resized[i] = false;
    vis[i] = true; was_hidden[i] = false;
  }

  while (g_thread_run) {
    if (g_dwm_flush) { if (FAILED(g_dwm_flush())) Sleep(4); }
    else Sleep(4);
    if (!g_thread_run) break;

    const long long now = qpc_now();
    const long long t_flush = now;
    if (last && g_qpf > 0) {
      const double dt = (double)(now - last) / (double)g_qpf;
      if (dt > 0.0005 && dt < 0.5) {
        const double hz = 1.0 / dt;
        g_vsync_hz = (g_vsync_hz <= 0.0) ? hz : (g_vsync_hz * 0.9 + hz * 0.1);
      }
    }
    last = now;
    ++g_vsync_frames;
    const double period = (g_vsync_hz > 1.0) ? (1.0 / g_vsync_hz) : (1.0 / 60.0);

    // ========================================================================
    // CE QUI ATTENDAIT D'ETRE PRESENTE
    // ========================================================================
    // `DwmFlush` vient de rendre la main : le compositeur de Windows a fini sa
    // passe, et on dispose d'un intervalle entier avant sa photo suivante.
    // Ce qui n'a pas pu etre presente dans sa passe (voir `maybe_present`) part
    // maintenant.
    for (int i = 0; i < kMaxWin; ++i) {
      Win* w = g_wins[i];
      if (w && w->hwnd && w->pres_due) present_win(*w);
    }

    // ========================================================================
    // LA SOURIS, LUE PAR CE FIL
    // ========================================================================
    // Voir `on_mouse_move` : un message de souris n'arrive que si le fil
    // principal pompe, et il ne pompe pas pendant une frame Lua. On lit le
    // pointeur ici, a chaque passe, pour chaque fenetre.
    bool gesture = false;
    for (int i = 0; i < kMaxWin; ++i) {
      Win* w = g_wins[i];
      if (!w || !w->hwnd) { vis[i] = true; was_hidden[i] = false; continue; }
      // ⚠ UNE FENETRE CACHEE NE SE RECOMPOSE PLUS. Une liaison a l'horloge
      // (un LFO qui ondule, une tete de lecture) la faisait recomposer a la
      // cadence de l'ecran sous un onglet que personne ne regarde. Lire la
      // visibilite d'ici est sur : c'est un bit de style, comme le rectangle
      // client qu'on lit deja trois lignes plus bas.
      vis[i] = IsWindowVisible(w->hwnd) != FALSE;
      int mx, my;
      if (poll_mouse(*w, &mx, &my)) { w->live.mx = mx; w->live.my = my; }
      if (w->mb) gesture = true;
      RECT rc; GetClientRect(w->hwnd, &rc);
      const int cw = rc.right - rc.left, chh = rc.bottom - rc.top;
      resized[i] = (cw != last_w[i] || chh != last_h[i]);
      if (resized[i]) { last_w[i] = cw; last_h[i] = chh; }
    }

    // ========================================================================
    // LES PARTIELS D'ABORD, LES PLEINS ENSUITE, ET PAS AU-DELA DU BUDGET
    // ========================================================================
    // ⚠ UN SEUL FIL POUR TOUTES LES FENETRES, ET C'EST VOULU. Un fil par
    // fenetre voudrait dire seize `DwmFlush` concurrents sur le meme ecran.
    // Ici une passe sert celles qui en ont besoin -- mais dans un ORDRE : ce
    // qui suit la souris a 120 Hz (une retouche de quelques microsecondes)
    // ne doit pas attendre derriere la composition pleine d'une autre fenetre,
    // qui peut couter des millisecondes et n'est attendue qu'a 30 Hz.
    for (int i = 0; i < kMaxWin; ++i) {
      Win* w = g_wins[i];
      if (!w || !w->hwnd || w->ready_new) continue;
      // Cachee : on passe, et `dirty` reste leve pour la passe ou elle
      // reapparait. Remontree : une composition d'office, parce que ce qui
      // suit l'horloge a continue d'avancer pendant qu'on ne le dessinait pas.
      // ⚠ SEULEMENT LES PARTIELS. Une frame NEUVE se compose meme cachee
      // (boucle suivante) : elle peut porter la cuisson d'une icone, qui ne
      // s'execute qu'au rejeu.
      if (!vis[i]) { was_hidden[i] = true; continue; }
      const bool reshown = was_hidden[i];
      was_hidden[i] = false;
      const bool clock = cp::list::has_clock(*w->play);
      const bool moved = (w->live.mx != w->live_drawn.mx || w->live.my != w->live_drawn.my);
      // Une image neuve attend dans une case video (ABI 4.1) : c'est un autre
      // fil qui l'a posee, rien d'autre ne reveillerait la fenetre.
      const bool video = cp::video::pending(w);
      if (InterlockedExchange(&w->dirty, 0) != 0 || clock || resized[i] || moved || reshown ||
          video) {
        compose_win(*w, false);
        maybe_present(*w, t_flush);
      }
    }
    bool one_full = false;
    for (int i = 0; i < kMaxWin; ++i) {
      Win* w = g_wins[i];
      if (!w || !w->hwnd || !w->ready_new) continue;
      const double el = (g_qpf > 0) ? (double)(qpc_now() - t_flush) / (double)g_qpf : 0.0;
      // Au moins UNE frame neuve par passe, sinon une machine lente ne
      // progresserait jamais ; les suivantes attendent si la passe est
      // entamee. `dirty` reste leve, elles reviennent a la passe d'apres.
      if (one_full && el > kFullBudget * period) continue;
      InterlockedExchange(&w->dirty, 0);
      compose_win(*w, false);
      maybe_present(*w, t_flush);
      one_full = true;
    }

    // ========================================================================
    // LE TICK FORCE PENDANT UN GESTE
    // ========================================================================
    if (g_boost_mode >= 2 && g_qpf > 0) {
      const long long tin = g_input_qpc;
      const bool recent = tin && (double)(now - tin) / (double)g_qpf < 0.3;
      if (g_boost_mode >= 3 || gesture || recent) {
        if (!g_boost_last || (double)(now - g_boost_last) / (double)g_qpf >= 1.0 / g_boost_hz) {
          tick_boost();
          g_boost_last = now;
        }
      }
    }
  }
  return 0;
}

void start_worker() {
  if (g_thread) return;
  if (!g_fonts[1].at.ready) {
    cp::log::line("fil de rejeu : REFUSE, atlas non cuit (texte en repli GDI)");
    return;
  }
  if (!g_cs_ok) { InitializeCriticalSection(&g_cs_front);
                  InitializeCriticalSection(&g_cs_pub); g_cs_ok = true; }
  if (!g_dwmapi) {
    g_dwmapi = LoadLibraryA("dwmapi.dll");
    if (g_dwmapi)
      g_dwm_flush = (DwmFlushFn)GetProcAddress(g_dwmapi, "DwmFlush");
  }
  g_thread_run = 1;
  unsigned id = 0;
  g_thread = (HANDLE)_beginthreadex(nullptr, 0, vsync_worker, nullptr, 0, &id);
  if (!g_thread) g_thread_run = 0;
  cp::log::line("fil de rejeu : %s (%s)", g_thread ? "demarre" : "ECHEC",
                g_dwm_flush ? "vsync DwmFlush" : "minuteur 4 ms");
}

// ⚠ AVANT DE DETRUIRE QUOI QUE CE SOIT. Le fil touche la fenetre, les tampons
// et les atlas ; les liberer pendant qu'il tourne, c'est planter REAPER.
void stop_worker() {
  if (!g_thread) return;
  cp::log::line("fil de rejeu : arret demande");
  InterlockedExchange(&g_thread_run, 0);
  WaitForSingleObject(g_thread, 3000);
  CloseHandle(g_thread);
  g_thread = nullptr;
}

void request_compose(Win& wn) {
  if (g_thread) { InterlockedExchange(&wn.dirty, 1); return; }
  compose_win(wn, true);
}

void set_value(int slot, double v, double tau_ms, int mode) {
  if (slot < 0 || slot >= cp::list::kSlots) return;
  // ⚠ LA PREMIERE ECRITURE POSE LA VALEUR MONTREE. Sans ca, une case qui
  // glisse part de zero et la liste tombe du haut a l'ouverture de la fenetre —
  // une animation que personne n'a demandee, a chaque lancement.
  if (mode == 1 && W.mode[slot] != 1) W.shown[slot] = v;
  W.val[slot] = v;
  W.tau[slot] = (tau_ms > 0.0) ? (tau_ms * 0.001) : 0.0;
  W.mode[slot] = mode;
}

// ⚠ IL NE REDIMENSIONNE PLUS RIEN. Les tampons appartiennent au compositeur ;
// si le fil principal les touchait ici, il les redimensionnerait pendant que le
// fil de rejeu ecrit dedans. Il ne fait que LIRE la taille de la fenetre — et
// c'est celle-la que Lua doit avoir, pas celle du tampon, qui peut avoir une
// image de retard pendant un redimensionnement.
bool begin_frame(int* w, int* h) {
  if (!W.hwnd) return false;
  if (g_probe.fmt != kFmtARGB32) return false;
  RECT rc; GetClientRect(W.hwnd, &rc);
  int cw = rc.right - rc.left, ch2 = rc.bottom - rc.top;
  if (cw < 2) cw = 2;
  if (ch2 < 2) ch2 = 2;
  mark_begin();
  // ⚠ LE DECOUPAGE REPART A PLAT A CHAQUE FRAME. Un `clip_push` sans son
  // `clip_reset` ne doit pas pouvoir faire disparaitre la frame SUIVANTE : un
  // defaut qui survit a la frame ou il a ete commis est introuvable.
  clip_reset();
  W.poly_n = 0;
  W.tint_n = 0;
  cp::list::reset(*W.build, cw, ch2);
  W.win_w = cw; W.win_h = ch2;
  if (w) *w = cw;
  if (h) *h = ch2;
  return true;
}

// ⚠ LUA NE COMPOSE PLUS. Il pose sa frame dans `ready`, leve le drapeau, et
// s'en va. Le fil de rejeu la prendra au balayage suivant — au pire 8,3 ms,
// donc MIEUX que les 33 ms d'avant, et surtout sans jamais faire attendre le
// fil qui dessine l'arrangement de REAPER.
void end_frame() {
  if (!W.hwnd) return;
  // ⚠ ON SCELLE AVANT DE PUBLIER, DONC SUR LE FIL DE LUA. `finalize` trie les
  // portees et calcule leur boite : elle ECRIT dans la frame. La faire au rejeu
  // reviendrait a ecrire depuis le fil de composition dans ce que Lua vient de
  // lui donner — et a le refaire 120 fois par seconde pour un resultat qui ne
  // change plus.
  cp::list::finalize(*W.build);
  // ⚠⚠ LE VERROU COURT, ET C'EST TOUTE LA DIFFERENCE DE CADENCE.
  // Ceci tourne sur le fil de LUA, une fois par frame. Sur `g_cs_front` il
  // attendait derriere la rasterisation partielle du fil de rejeu -- jusqu'a
  // plusieurs millisecondes, cent vingt fois par seconde, et une section
  // critique ne fait pas la queue equitablement. Ici il n'attend que d'autres
  // echanges de pointeurs.
  if (g_cs_ok) EnterCriticalSection(&g_cs_pub);
  // ⚠⚠ UNE FRAME PAS ENCORE PRISE N'EST PAS ECRASEE : ELLE EST MISE DE COTE.
  // Voir `Win::spill`. Si la case de cote est deja prise -- le compositeur n'a
  // pas tourne depuis deux frames, une machine a genoux -- la plus recente des
  // deux non prises est perdue, et ca se compte : c'est le seul cas ou une
  // cuisson d'icone peut encore se perdre.
  if (W.ready_new) {
    if (!W.spill_new) {
      cp::list::Frame* t = W.spill; W.spill = W.ready; W.ready = t;
      W.spill_new = true;
      ++W.spilled;
    } else {
      ++W.dropped;
    }
  }
  { cp::list::Frame* t = W.ready; W.ready = W.build; W.build = t; }
  W.ready_new = true;
  if (g_cs_ok) LeaveCriticalSection(&g_cs_pub);
  ++W.frames;
  request_compose(W);
}

// ⚠ A PARTIR D'ICI, PLUS RIEN NE DESSINE : TOUT ENREGISTRE. Un ordre coute
// desormais une recopie de structure — moins cher que le dessin qu'il
// remplacait — et la frame devient rejouable sans Lua.
inline int clamp_a(int a) { return a < 0 ? 0 : (a > 255 ? 255 : a); }

void draw_rect(double x, double y, double w, double h, unsigned int col, int alpha) {
  cp::list::Cmd c = {};
  c.op = cp::list::kOpRect;
  c.d[0] = x; c.d[1] = y; c.d[2] = w; c.d[3] = h;
  c.c0 = col; c.i0 = clamp_a(alpha);
  cp::list::push(*W.build, c);
}

// UN SEUL APPEL POUR LE REMPLISSAGE ET LE CONTOUR. C'est la raison d'etre de
// toute cette couche : sous `gfx` cette forme coutait dix traversees.
